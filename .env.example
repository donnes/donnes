# Server-only. Paste your OpenRouter key here. Never use a PUBLIC_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Per warm server process, NOT a global spending cap. 0 disables paid calls.
# Set a credit limit on this key in OpenRouter for a hard spending cap.
HABITAT_MAX_CALLS_PER_DAY=8

# Optional tennis coach. Separate from OpenRouter; server-only.
TYPESAFE_API_KEY=
# Per warm process. 0 disables calls. Policies are cached for one hour.
TYPESAFE_MAX_CALLS_PER_DAY=4
