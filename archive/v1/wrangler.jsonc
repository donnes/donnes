{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "donnes-v1",
  "main": "./worker.js",
  "compatibility_date": "2026-10-12",
  "routes": [{ "pattern": "v1.donnes.dev/*", "zone_name": "donnes.dev" }],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./site",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/_next/image"]
  }
}
