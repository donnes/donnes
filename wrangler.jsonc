{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "donnes",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-12",
  // A zone route rather than a Custom Domain, so the proxied DNS records stay ours to manage.
  // www redirects to the apex with a zone Redirect Rule, which runs before the Worker.
  "routes": [{ "pattern": "donnes.dev/*", "zone_name": "donnes.dev" }],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
    // `/` negotiates between HTML and Markdown; the endpoints hold the server-side keys
    "run_worker_first": ["/", "/api/*"]
  },
  // Secrets, set with `wrangler secret put`: OPENROUTER_API_KEY, TYPESAFE_API_KEY, GOOGLE_WEATHER_API_KEY
  "vars": {
    "OPENROUTER_MODEL": "z-ai/glm-5.3-flash",
    "HABITAT_MAX_CALLS_PER_DAY": "8",
    "TYPESAFE_MAX_CALLS_PER_DAY": "4"
  },
  "observability": {
    "enabled": true
  }
}
