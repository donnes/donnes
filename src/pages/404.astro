---
// The 404 is the same beach on a day off: nothing left on the sand, an empty court, and "404" drawn by the water.
import BeachHome from "../components/beach/beach-home.astro";
import BeachLayout from "../components/beach/beach-layout.astro";
import { SITE } from "../constants";
---

<BeachLayout lang="en" title={`404 | ${SITE.TITLE}`} description="The page you are looking for could not be found.">
  <!-- one static 404.html answers every path: it speaks Portuguese when the missing page was under /pt-br -->
  <script is:inline>
    if (/^\/pt-br(\/|$)/i.test(location.pathname)) {
      document.documentElement.lang = "pt-BR";
      addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("[data-pt]").forEach((el) => (el.textContent = el.dataset.pt));
        document.querySelectorAll("[data-pt-label]").forEach((el) => el.setAttribute("aria-label", el.dataset.ptLabel));
        document.getElementById("jb-nf-home")?.setAttribute("href", "/pt-br/");
      });
    }
  </script>
  <BeachHome lang="en" notFound />
</BeachLayout>
