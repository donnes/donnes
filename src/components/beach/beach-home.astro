  /* ───────────── deriving the SceneState (real data, or a labelled preview) ───────────── */
  const SKIES = Object.keys(SKY) as Sky[];
  const PHASE_NAMES = Object.keys(PHASES) as Phase[];
  const over = { wx: params.get("wx") || "", tod: (params.get("tod") === "day" ? "midday" : params.get("tod") || "") as Phase | "", temp: params.get("temp") ? Number(params.get("temp")) : NaN };
  function readState(): SceneState {
    const [sr, ss] = live ? [live.sunrise, live.sunset] : sunTimes();
