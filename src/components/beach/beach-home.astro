        { transform: `rotateY(${(k0 + k1) / 2 + (fwd ? -40 : 40)}deg) skewY(${bend * 0.6}deg) scaleX(.985)`, offset: 0.66 },
        { transform: `rotateY(${k1}deg) skewY(0deg) scaleX(1)` },
