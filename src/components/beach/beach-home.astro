  .jb-obj:hover .jb-tag, .jb-obj:focus-visible .jb-tag { transform: translateX(-50%) rotate(-1deg) translateY(2px); }
  .jb-obj[aria-expanded="true"] .jb-tag { background: #ffe9a8; }
  .jb-o-about .jb-tag { left: 46%; top: calc(100% - 2px); }
  .jb-o-work .jb-tag { top: calc(100% - 30px); left: 42%; }
  .jb-o-stack .jb-tag { top: calc(100% - 12px); }
  .jb-o-contact .jb-tag { top: calc(100% - 10px); left: 44%; }
  /* things change with the weather and the hour: every change is a small animated hand-over */
  .jb-o-about .jb-idle { transform-origin: 56.6% 93.5%; }
  .o-can-open { transform-origin: 0px -92px; transition: transform 0.9s cubic-bezier(0.3, 1.4, 0.5, 1), opacity 0.25s ease; }
  [data-umb="shut"] .o-can-open { transform: scale(0.1, 1.28); opacity: 0; transition: transform 0.8s cubic-bezier(0.5, 0, 0.6, 1), opacity 0.2s ease 0.6s; }
  .o-can-shut { opacity: 0; transform-origin: 196px 150px; transform: scaleX(2.4); transition: opacity 0.2s ease, transform 0.3s ease; }
  [data-umb="shut"] .o-can-shut { opacity: 1; transform: none; transition: opacity 0.2s ease 0.58s, transform 0.5s var(--spring) 0.58s; }
  .o-cover { transform-box: fill-box; transform-origin: 50% 0; transform: scaleY(0); opacity: 0; transition: transform 0.7s cubic-bezier(0.5, 0, 0.3, 1), opacity 0.2s ease 0.5s; }
  [data-tuck] .o-cover { transform: none; opacity: 1; transition: transform 0.9s var(--spring), opacity 0.15s ease; }
