  html { background: #f3cf95; }
  body { font-family: var(--sans); color: var(--ink); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  html.js, html.js body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  .jb-paintbox { position: absolute; }
  .jb-world a { color: inherit; }
  .jb-world :focus-visible { outline: 2.5px solid var(--green); outline-offset: 2px; border-radius: 4px; }
  .jb-world .jb-panel:focus-visible, .jb-world .jb-book:focus-visible { outline: none; }

  /* ── paint classes ── */
  .st-sky0 { stop-color: var(--sky-0); } .st-sky1 { stop-color: var(--sky-1); }
  .st-sky2 { stop-color: var(--sky-2); } .st-sky3 { stop-color: var(--sky-3); }
  .st-halo { stop-color: var(--halo); }
  .veil-flood { flood-color: var(--veil); }
  .sky-strokes path { fill: none; stroke: var(--cloud-hi); stroke-linecap: round; }
  .stars { fill: #fff; opacity: calc(var(--stars) * (0.25 + 0.75 * var(--clear, 1))); }
  .sun { fill: var(--sun); }
  .moon-dark { fill: #b9c4e6; opacity: 0.2; } .moon-lit { fill: #fdf8e3; } .moon-mare { fill: #e3dcc0; opacity: 0.75; }
  .kite-line { fill: none; stroke: var(--v-dark); stroke-width: 0.8; opacity: 0.7; } .kite-wing { fill: var(--v-coral); } .kite-body { fill: var(--v-dark); }
  .kite-board { fill: none; stroke: var(--v-gold); stroke-width: 2.6; stroke-linecap: round; } .kite-spray { fill: none; stroke: var(--foam); stroke-width: 1.6; stroke-linecap: round; }
  .wetsand { fill: #8f6f4a; } .puddles { fill: var(--sky-2); opacity: 0.5; } .puddle-hi path { fill: none; stroke: #fff; stroke-width: 2.5; stroke-linecap: round; opacity: 0.55; }
  .c-shade { fill: var(--cloud-shade); } .c-body { fill: var(--cloud); } .c-hi { fill: var(--cloud-hi); opacity: 0.85; }
  .far1 { fill: var(--far-1); } .far2 { fill: var(--far-2); }
  .sea0 { fill: var(--sea-0); } .sea1 { fill: var(--sea-1); } .sea2 { fill: var(--sea-2); } .sea3 { fill: var(--sea-3); } .sea4 { fill: var(--sea-4); }
  .foam { fill: var(--foam); }
  .tones path { fill: none; stroke-linecap: round; } .t-dk { stroke: var(--sea-0); } .t-lt { stroke: var(--sea-4); }
  .glitter path { fill: none; stroke: var(--glitter); stroke-linecap: round; }
  .waves path { fill: none; stroke: var(--foam); stroke-linecap: round; }
  .waves .lace { stroke-width: 4; opacity: 0.85; }
  .refl { fill: var(--hill-dk); opacity: 0.3; }
  .h-md { fill: var(--hill); } .h-dk { fill: var(--hill-dk); } .h-lt { fill: var(--hill-lt); }
  .wall { fill: var(--p-wall); } .roof-a { fill: var(--p-roof-a); } .roof-b { fill: var(--p-roof-b); }
  .sail path { fill: var(--v-cream); } .sail .hullf { fill: var(--v-char); }
  .hull { fill: var(--v-cream); } .hull-stripe { fill: var(--v-coral); } .cabin { fill: var(--v-teal); } .cabin-win { fill: var(--v-cream); }
  .mast { fill: none; stroke: var(--v-dark); stroke-width: 2.5; }
  .pennant { fill: var(--v-gold); }
  .lamp { fill: #ffd977; opacity: var(--lights); }
  .crown .h-md { fill: var(--v-hill); } .crown .h-dk { fill: var(--v-hill-dk); } .crown .h-lt { fill: var(--v-hill-lt); } .crown .coco { fill: var(--v-brown); }
  .xstars { fill: #fff; }
  .swell path { fill: none; stroke: var(--sea-4); stroke-linecap: round; opacity: 0.4; }
  .wash-film { fill: var(--sea-4); opacity: 0.6; } .wash-foam { fill: var(--foam); }
  .wash-lace { fill: none; stroke: var(--foam); stroke-width: 3.4; stroke-linecap: round; opacity: 0.8; }
  .sheen { fill: #8a6230; opacity: 0.5; }
  .boat-refl path { fill: none; stroke: var(--sea-0); stroke-width: 4; stroke-linecap: round; opacity: 0.45; }
  .wet { fill: var(--wet); } .sand { fill: var(--sand); } .dune { fill: var(--dune); }
  .sand-strokes path { fill: none; stroke-linecap: round; opacity: 0.5; }
  .sand-strokes .s-lt { stroke: var(--sand-lt); } .sand-strokes .s-dk { stroke: var(--sand-dk); }
  circle.s-dk { fill: var(--p-speck-dk); opacity: 0.7; } circle.s-lt { fill: var(--p-speck-lt); opacity: 0.9; }
  .starfish { fill: var(--p-starfish); } .shells { fill: var(--p-shell); stroke: var(--p-speck-dk); stroke-width: 1.2; }
  .trunk { fill: var(--p-trunk); } .rings path { fill: none; stroke: var(--p-ring); stroke-width: 1.8; opacity: 0.6; }
  .blades path { fill: none; stroke-linecap: round; }
  .blades .g1 { stroke: var(--g1); } .blades .g2 { stroke: var(--g2); } .blades .g3 { stroke: var(--g3); } .blades .straw { stroke: var(--straw); }
  .seedhead { fill: var(--p-seed); }
  /* object paint */
  .o-cream { fill: var(--v-cream); } .o-white { fill: var(--v-white); } .o-coral { fill: var(--v-coral); } .o-teal { fill: var(--v-teal); } .o-gold { fill: var(--v-gold); }
  .o-green { fill: var(--v-green); } .o-navy { fill: var(--v-navy); } .o-amber { fill: var(--v-amber); } .o-dark { fill: var(--v-dark); } .o-cork { fill: var(--v-cork); }
  .o-pages { fill: var(--v-pages); } .o-fold { fill: var(--v-fold); } .o-under { fill: var(--v-under); }
  .o-glass { fill: var(--v-glass); opacity: 0.88; }
  .o-glint { fill: none; stroke: var(--v-white); stroke-width: 4; stroke-linecap: round; opacity: 0.9; }
  .o-shadow { fill: var(--v-shade); opacity: 0.34; } .o-shadow.wetsh { opacity: 0.28; }
  /* shadows follow the sun: pushed away from it, longer when it is low, gone under a grey sky */
  .o-sh { transform-box: fill-box; transform-origin: 50% 50%; transform: translateX(calc(var(--sh-x, 0.5) * var(--sk, 1) * 60px)) scaleX(var(--sh-l, 1)); opacity: var(--sh-o, 0.34); transition: transform 1.2s ease, opacity 1.2s ease; }
  [data-umb="shut"] .o-sh-umb { transform: translateX(calc(var(--sh-x, 0.5) * 24px)) scaleX(0.3); }
  .o-strap { fill: none; stroke: var(--v-navy); stroke-width: 4; stroke-linecap: round; }
  .o-cover-line { fill: none; stroke: var(--v-shade); stroke-width: 2; stroke-linecap: round; opacity: 0.45; }
  .o-lan-wire { fill: none; stroke: var(--v-dark); stroke-width: 2.6; stroke-linecap: round; } .o-lan-lit { fill: #ffd977; opacity: var(--lights); }
  .o-pole { fill: none; stroke: var(--v-pole); stroke-width: 7; stroke-linecap: round; }
  .o-line { fill: none; stroke: var(--v-dark); stroke-width: 2.4; stroke-linecap: round; opacity: 0.55; } .o-line.lt { stroke: var(--v-cream); opacity: 0.8; } .o-line.dk { stroke: var(--v-amber); stroke-width: 2; opacity: 0.8; }
  .o-fringe { fill: none; stroke: var(--v-cream); stroke-width: 3; stroke-linecap: round; }
  .o-handle { fill: none; stroke: var(--v-white); stroke-width: 7; stroke-linecap: round; }
  .o-shades { fill: var(--v-char); stroke: var(--v-char); stroke-width: 3; }

  /* ── the scene ── */
  .jb-scene { position: absolute; inset: 0 0 auto 0; height: 60svh; overflow: hidden; z-index: 0; background: var(--sky-1); }
  html.js .jb-scene { position: fixed; height: 100svh; }
  .jb-draft { will-change: opacity; position: fixed; inset: 0; z-index: 3; overflow: hidden; pointer-events: none; background: #f5f0e5; }
  .jb-deck-drawing { display: none; } /* cloud contours, read by the pencil canvas only */
  .jb-layer { position: absolute; inset: -24px; width: calc(100% + 48px); height: calc(100% + 48px); display: block; }
  html.js .jb-nojs { display: none; }
  .jb-xstars { opacity: calc(var(--stars) * var(--clear, 0.5)); }
  .jb-sheen-l, .jb-wash-l { opacity: 0; }
  .jb-glit-a, .jb-glit-b, .jb-swell, .jb-shimmer-a, .jb-shimmer-b, .jb-wash-l, .jb-sheen-l { transform-origin: 50% var(--hz, 25%); }
  .jb-wash-a { --amp: calc(0.094 * var(--amp-k, 1)); } .jb-wash-b { --amp: calc(0.05 * var(--amp-k, 1)); } .jb-wash-c { --amp: calc(0.075 * var(--amp-k, 1)); display: none; }
  [data-storm] .jb-wash-c { display: block; }

  /* stages: a 1600×1000 board laid exactly over the painting; sprites are placed in painting units */
  .jb-stage { display: none; }
  html.js .jb-stage { display: block; position: absolute; left: 0; top: 0; width: 1600px; height: 1000px; transform-origin: 0 0; transform: translate(var(--ox, 0px), var(--oy, 0px)) scale(var(--fs, 1)); pointer-events: none; }
  .jb-stage > * { position: absolute; }
  .jb-spr { display: block; overflow: hidden; }
  .jb-cloud { opacity: 0; transition: opacity 2.6s ease; }
  .jb-st-sky { opacity: calc(var(--stars) * var(--clear, 1)); }
  /* sun, moon, and the glow they leave on the horizon: placed by the script along the day's arc */
  .jb-sun, .jb-moon { left: 0; top: 0; width: 0; height: 0; }
  .jb-sun > *, .jb-moon > * { position: absolute; left: 0; top: 0; translate: -50% -50%; }
  .jb-sun-disc { width: 100px; height: 100px; } .jb-moon svg { width: 76px; height: 76px; }
  .jb-halo { width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--halo) 78%, transparent), transparent); }
  .jb-halo-moon { width: 190px; height: 190px; background: radial-gradient(closest-side, rgb(207 216 242 / 0.4), transparent); }
  .jb-rays { width: 620px; height: 620px; border-radius: 50%; opacity: var(--rays, 0);
    background: repeating-conic-gradient(from 0deg, rgb(255 244 190 / 0) 0deg 9deg, rgb(255 244 190 / 0.34) 13deg 17deg, rgb(255 244 190 / 0) 21deg 30deg);
    -webkit-mask-image: radial-gradient(closest-side, #000 18%, transparent 92%); mask-image: radial-gradient(closest-side, #000 18%, transparent 92%); }
  .jb-glow { left: 0; top: 0; width: 1300px; height: 440px; margin: -220px 0 0 -650px; border-radius: 50%; opacity: var(--glow, 0);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--sun) 80%, transparent), color-mix(in srgb, var(--halo) 40%, transparent) 45%, transparent); }
  .jb-shoot { width: 110px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #fff, transparent); rotate: -24deg; opacity: 0; }
  /* the overcast deck: three lumpy bands (CSS masks, so the palette paints them) rolled along by the wind */
  .jb-deck { left: -800px; width: 3200px; top: -70px; opacity: var(--deck, 0); transition: opacity 0.4s linear; -webkit-mask-size: 800px 100%; mask-size: 800px 100%; -webkit-mask-repeat: repeat-x; mask-repeat: repeat-x; }
  .jb-deck-back { height: 262px; background: linear-gradient(var(--cloud-shade), color-mix(in srgb, var(--cloud-shade) 72%, var(--sky-0))); }
  .jb-deck-front { height: 205px; background: linear-gradient(color-mix(in srgb, var(--cloud) 40%, var(--cloud-shade)), color-mix(in srgb, var(--cloud) 72%, var(--cloud-shade))); }
  .jb-deck-hi { height: 140px; top: -40px; background: color-mix(in srgb, var(--cloud-hi) 70%, var(--cloud-shade)); opacity: calc(var(--deck, 0) * 0.55); }
  .jb-flash { position: absolute; inset: 0; opacity: 0; pointer-events: none; background: linear-gradient(rgb(226 234 255 / 0.95), rgb(226 234 255 / 0.5) 34%, rgb(226 234 255 / 0.16) 70%); }
  .jb-bolt { left: 0; top: 104px; width: 62px; height: 140px; opacity: 0; overflow: visible; }
  .jb-bolt path { fill: none; stroke: #f6f8ff; stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .jb-sparks { left: 0; top: 0; width: 0; height: 0; opacity: var(--glit, 1); }
  .jb-spark { position: absolute; margin: -4px 0 0 -4px; background: #fff; clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); opacity: 0.85; }
  .jb-glit-a use, .jb-glit-b use { transform-origin: 870px 235px; transform: translateX(var(--lum-dx, 0px)) scaleX(var(--glit-w, 1)); opacity: var(--glit, 1); }
  .jb-cap { display: none; height: 3px; border-radius: 2px; background: var(--foam); opacity: 0; }
  [data-caps] .jb-cap { display: block; opacity: 0.6; }
  [data-storm] .jb-cap { height: 4.5px; scale: 1.7 1; }
  .jb-sail-go, .jb-kite-go { transition: opacity 3s ease; }
  .jb-sail-go > svg { width: 100%; height: 100%; }
  [data-storm] .jb-sail-go, [data-noboats] .jb-sail-go { opacity: 0; }
  .jb-kite-go { width: 0; height: 0; opacity: 0; }
  [data-kite] .jb-kite-go { opacity: 1; }
  .jb-kite { position: absolute; left: -45px; top: -59px; width: 67px; height: 67px; overflow: visible; transform-origin: 66% 88%; }
  .jb-boat-wrap { transition: translate 9s cubic-bezier(0.3, 0, 0.3, 1), opacity 3s ease 1s; }
  [data-storm] .jb-boat-wrap { translate: -760px 0; opacity: 0; transition: translate 9s cubic-bezier(0.6, 0, 0.9, 0.6), opacity 3s ease 5s; }
  .jb-boat-bob { position: absolute; inset: 0; } .jb-boat-bob > .jb-spr { width: 100%; height: 100%; }
  .jb-pennant { position: absolute; left: 65.6%; top: 11.9%; width: 11.7%; height: 11%; transform-origin: 0 50%; scale: var(--wdir, 1) 1; }
  [data-fog] .jb-boat-wrap, [data-fog] .jb-sail-go { filter: grayscale(1) brightness(0.62) opacity(0.75); }
  /* rain lands: dark blotches first, then the whole beach, then puddles; it dries much slower than it wets */
  .jb-wet-l { display: none; mix-blend-mode: multiply; }
  [data-wet] .jb-wet-l { display: block; }
  .jb-wet-blots { opacity: var(--wet-a, 0); } .jb-wet-full { opacity: var(--wet-b, 0); }
  .jb-mist { display: none; left: -900px; width: 3400px; opacity: calc(var(--fog, 0) * var(--mo, 1));
    background: radial-gradient(closest-side, var(--mist-c, #e6ecef), transparent) 0 0 / 900px 100% repeat-x, radial-gradient(closest-side, var(--mist-c, #e6ecef), transparent) 300px 20% / 450px 70% repeat-x, linear-gradient(transparent, color-mix(in srgb, var(--mist-c, #e6ecef) 62%, transparent) 40% 62%, transparent); }
  [data-mist] .jb-mist { display: block; }
  .jb-heat { display: none; left: 700px; top: 528px; width: 1000px; height: 56px; rotate: -5.6deg; opacity: 0.6;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0) 0 18px, rgb(255 253 240 / 0.85) 26px 34px, rgb(255 255 255 / 0) 42px 60px);
    -webkit-mask-image: radial-gradient(closest-side, #000 40%, transparent); mask-image: radial-gradient(closest-side, #000 40%, transparent); }
  [data-hot] .jb-heat { display: block; }
  .jb-cshade { border-radius: 50%; background: radial-gradient(closest-side, rgb(24 60 100 / 0.26) 25%, transparent); opacity: var(--cshade, 0); }
  .jb-spray { display: none; left: -120px; top: 420px; width: 1840px; height: 190px; rotate: -5.2deg; opacity: var(--spray, 0); background: linear-gradient(transparent, rgb(236 243 248 / 0.6) 55%, transparent); }
  [data-rain] .jb-spray { display: block; }
  .jb-splash { display: none; width: 15px; height: 7px; margin: -7px 0 0 -7px; border: 1.6px solid rgb(255 255 255 / 0.8); border-bottom: 0; border-radius: 50% 50% 0 0 / 100% 100% 0 0; scale: var(--s, 1); opacity: 0.7; }
  [data-rain] .jb-splash { display: block; }
  .jb-wisp { display: none; left: 0; height: 7px; border-radius: 50%; background: linear-gradient(90deg, transparent, rgb(255 250 232 / 0.95), transparent); box-shadow: 0 4px 5px -1px rgb(150 100 40 / 0.28); opacity: 0; }
  [data-windy] .jb-wisp { display: block; }
  .jb-gull { left: 0; top: 0; width: 46px; height: 40px; margin: -36px 0 0 -23px; opacity: 0; transition: opacity 0.5s; }
  .jb-gull.is-out { opacity: 1; }
  .jb-gull svg { width: 100%; height: 100%; overflow: visible; }
  .gull-body { fill: var(--v-white); } .gull-wing { fill: #8d99a6; } .gull-beak { fill: var(--v-gold); } .gull-eye { fill: var(--ink); }
  .gull-leg { fill: none; stroke: var(--v-amber); stroke-width: 1.8; stroke-linecap: round; }
