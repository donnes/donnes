  .jb-top { position: absolute; z-index: 5; top: 18px; right: 18px; display: flex; flex-direction: column-reverse; align-items: flex-end; gap: 5px; }
  .jb-lang { display: flex; align-items: center; gap: 1px; margin-right: -4px; color: var(--on-sky); font: 500 11px/1 var(--mono); letter-spacing: 0.06em; transition: color 1.2s ease, opacity 0.2s, visibility 0.2s; }
