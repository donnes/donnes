  .jb-scribble { display: flex; align-items: center; gap: 8px; margin: 12px 0 0; font: 500 22px/1 var(--hand); color: #a3391f; transform: rotate(-2deg); transform-origin: left; }
  .jb-scribble svg { width: 44px; height: 14px; flex: none; } .jb-scribble path, .jb-doodle path { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .jb-pg-r { margin-top: 14px; }
  .jb-built { margin: 0 0 0; font: 500 11px/26px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--green); }
  .jb-notes { list-style: none; margin: 0; padding: 0 0 0 26px; font-size: 14.5px; line-height: 26px; color: #2b2720; }
  .jb-notes li { position: relative; margin: 0 0 13px; } .jb-notes li:last-child { margin-bottom: 0; }
  .jb-notes li::before { content: "~"; position: absolute; left: -24px; width: 18px; text-align: center; font: 700 21px/26px var(--hand); color: #c4391f; }
  .jb-notes strong { font-weight: 560; background: linear-gradient(transparent 56%, #ffe08a 56% 94%, transparent 94%); }

  .jb-stack-lede { margin: 6px 0 0; font-size: 15px; line-height: 1.45; color: #2b2720; }
  .jb-bag { margin: 12px 0 0; display: grid; gap: 11px 22px; }
  .jb-bag > div { position: relative; padding-left: 16px; }
  .jb-bag > div::before { content: ""; position: absolute; left: 0; top: 5px; bottom: 3px; width: 6px; border-radius: 3px; background: var(--tab); border: 1.5px solid var(--ink); }
