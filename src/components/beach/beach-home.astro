  [data-lid] .o-cool-lid { opacity: 1; transform: none; transition: transform 0.6s cubic-bezier(0.3, 1.3, 0.5, 1), opacity 0.15s ease; }
  .jb-lamp-glow { position: absolute; left: 9.25%; top: 14.5%; width: 52%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; pointer-events: none; opacity: var(--lights, 0);
    background: radial-gradient(closest-side, rgb(255 214 120 / 0.6), rgb(255 186 90 / 0.2) 55%, transparent); }
  .jb-drip { display: none; position: absolute; width: 4px; height: 8px; margin-left: -2px; border-radius: 50% 50% 50% 50% / 68% 68% 38% 38%; background: #eaf6ff; opacity: 0.85; pointer-events: none; }
  [data-drip] .jb-drip { display: block; }
  .jb-sweat { display: none; position: absolute; left: 30%; top: 63%; width: 5px; height: 9px; border-radius: 50% 50% 50% 50% / 68% 68% 38% 38%; background: #f2fbff; opacity: 0.9; pointer-events: none; }
  [data-hot] .jb-sweat { display: block; }
  .jb-ball { border-radius: 50%; }
