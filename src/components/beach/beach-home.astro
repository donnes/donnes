  const PALS = {} as Record<BoxName, Pal>;
  let veiledBase: number[][] = [];
  {
    // Read all six palettes from isolated, empty nodes in one style pass.
    // Cycling data-tod on <html> used to restyle the entire beach six times at startup.
    const probes = BOXES.map(t => {
      const el = document.createElement("div");
      el.className = "jb-palette-probe";
