  let inviteGull = () => {};
  let inviteCrab = () => {};
  const habitatContext = (): Context => root.hasAttribute("data-night") ? "night"
    : env.rMid > 0.1 || env.storm > 0.1 || btWant === "wet" ? "wet" : env.wind > 0.55 ? "windy" : "sunny";
  async function requestHabitat(context: Context) {
    if (habitat.requests >= 2 || habitat.requested.has(context)) return;
    habitat.requested.add(context);
    habitat.requests++;
