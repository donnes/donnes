          if (Math.random() < 0.3) g.dir *= -1;
          g.mode = "hop";
          g.t = 0;
        }
      } else {
        const k = clamp(g.t / 0.32, 0, 1);
        put(g.x + g.dir * 16 * k, g.y - Math.sin(Math.PI * k) * 9);
        if (k >= 1) {
          g.x += g.dir * 16;
          g.mode = "stand";
          g.wait = rand(0.25, 1.6);
