      const response = await fetch(`/api/habitat?context=${context}`, { cache: "no-cache", signal: AbortSignal.timeout(14_000) });
      if (!response.ok) return;
      const data = await response.json();
      if (habitat.context === context) {
        reportHabitat(data);
        tennisPolicy = parseTennis(data.tennis?.policy) ?? LOCAL_TENNIS;
        root.dataset.tennisSource = data.tennis?.source === "typesafe" ? "typesafe" : "local";
      }
      const plan = parsePlan(data.plan, context);
      if (plan && habitat.context === context) {
        habitat.plan = plan;
        habitat.index = 0;
