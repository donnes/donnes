        mode = "fetch";
      } else if (mode === "fetch") {
        if (Math.abs(P[collector].tx - P[collector].x) > 3) return;
        showBall(false); // The collector returns the dead ball; the rules choose the server.
        placeEnds();
        server = match.server;
        P[server].tx = serveX(P[server].face);
        mode = "toServe";
        wait = rand(0.5, 0.9);
      } else if (mode === "toServe") {
