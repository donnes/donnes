  .jb-bt-pok { border: 1.6px solid #fffdf4; } .jb-bt-puff { height: 8px; margin-top: -6px; background: radial-gradient(closest-side, rgb(255 236 196 / 0.95), rgb(236 186 120 / 0.5) 60%, transparent); }
  /* ── 404: written in the sand with a stick (the grooves take the day's sand colours, so they follow the palette) ── */
  .jb-nf-sand { left: calc(var(--nf-x, 640) * 1px); top: calc(var(--nf-y, 800) * 1px); width: calc(var(--nf-w, 560) * 1px); height: auto; translate: -50% -50%; overflow: visible; visibility: hidden; }
  html.jb-ready .jb-nf-sand { visibility: visible; }
