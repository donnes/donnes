    --p-wall: #fbf3df; --p-roof-a: #d95a35; --p-roof-b: #b2452a; --p-speck-dk: #d29f5e; --p-speck-lt: #fff3d6; --p-starfish: #f0583a; --p-shell: #fff6e4; --p-trunk: #96704a; --p-ring: #6c5138; --p-seed: #c99c45;
    --v-dark: #4a3a2a; --v-char: #3a3a3a; --v-brown: #6c5138; --v-shade: #9a7440; --v-crab: #e0502f; --v-hill: #4fa45e; --v-hill-dk: #2e7d56; --v-hill-lt: #8fce62;
  }
  [data-tod="dawn"] {
