  .bt-tape { fill: rgb(255 244 214 / 0.2); stroke: var(--v-navy); stroke-width: 2; stroke-linejoin: round; opacity: 0.8; }
  .bt-post { fill: none; stroke: var(--v-white); stroke-width: 3.2; stroke-linecap: round; }
  .bt-pole { fill: none; stroke: var(--v-brown); stroke-width: 2.2; stroke-linecap: round; }
  .bt-wire { fill: none; stroke: var(--v-dark); stroke-width: 0.9; opacity: 0.75; }
  .bt-bulbs-lit { opacity: var(--lights, 0); } .bt-bulb-on { fill: #fff0b8; } .bt-bulb-halo { fill: rgb(255 210 110 / 0.3); }
  .bt-mesh { fill: var(--v-white); opacity: 0.3; } .bt-mesh-l { fill: none; stroke: var(--v-white); stroke-width: 0.8; opacity: 0.75; } .bt-band { fill: var(--v-coral); }
  .bt-puddle { fill: var(--sky-2); opacity: calc(var(--wet-b, 0) * 1.4); }
