  .o-can-shut { opacity: 0; transform-origin: 196px 150px; transform: scaleX(2.4); transition: opacity 0.2s ease, transform 0.3s ease; }
  [data-umb="shut"] .o-can-shut { opacity: 1; transform: none; transition: opacity 0.2s ease 0.58s, transform 0.5s var(--spring) 0.58s; }
  .o-cover { transform-box: fill-box; transform-origin: 50% 0; transform: scaleY(0); opacity: 0; transition: transform 0.7s cubic-bezier(0.5, 0, 0.3, 1), opacity 0.2s ease 0.5s; }
  [data-tuck] .o-cover { transform: none; opacity: 1; transition: transform 0.9s var(--spring), opacity 0.15s ease; }
  .o-shades, .o-blanket { transform-box: fill-box; transform-origin: 50% 50%; transition: opacity 0.6s ease, transform 0.6s var(--spring); }
  [data-noshades] .o-shades { opacity: 0; transform: scale(0.6); }
  .o-blanket { opacity: 0; transform: translateY(-16px) scale(0.8); }
  [data-cold] .o-blanket { opacity: 1; transform: none; }
  .o-cool-open { transition: opacity 0.3s ease 0.2s; }
  [data-lid] .o-cool-open { opacity: 0; transition: opacity 0.2s ease 0.45s; }
  .o-cool-lid { opacity: 0; transform-origin: 206px 116px; transform: rotate(40deg) translateY(-26px); transition: transform 0.5s cubic-bezier(0.5, 0, 0.8, 0.5), opacity 0.2s ease 0.3s; }
  [data-lid] .o-cool-lid { opacity: 1; transform: none; transition: transform 0.6s cubic-bezier(0.3, 1.3, 0.5, 1), opacity 0.15s ease; }
  .jb-lamp-glow { position: absolute; left: 9.25%; top: 14.5%; width: 52%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; pointer-events: none; opacity: var(--lights, 0);
    background: radial-gradient(closest-side, rgb(255 214 120 / 0.6), rgb(255 186 90 / 0.2) 55%, transparent); }
  .jb-drip { display: none; position: absolute; width: 4px; height: 8px; margin-left: -2px; border-radius: 50% 50% 50% 50% / 68% 68% 38% 38%; background: #eaf6ff; opacity: 0.85; pointer-events: none; }
  [data-drip] .jb-drip { display: block; }
  .jb-sweat { display: none; position: absolute; left: 30%; top: 63%; width: 5px; height: 9px; border-radius: 50% 50% 50% 50% / 68% 68% 38% 38%; background: #f2fbff; opacity: 0.9; pointer-events: none; }
  [data-hot] .jb-sweat { display: block; }
  .jb-ball { border-radius: 50%; }
  .jb-ball .jb-art svg + svg { position: absolute; inset: 0; }
  .jb-ball .jb-ball-art { transform-origin: 50% 47.2%; }
  .jb-ball:hover .jb-art, .jb-ball:focus-visible .jb-art { transform: translateY(-4px) scale(1.05); }

  /* ── the panel: one sheet of paper that springs out of whatever was picked up ── */
  .jb-panel { position: relative; z-index: 6; max-width: 720px; margin: 0 auto; outline: none; }
  .jb-paper { position: relative; }
  .jb-grab, .jb-close { display: none; }
  .jb-sec { position: relative; margin: 18px 0 0; padding: 24px 24px 26px; background: var(--cream); border: 1.5px solid var(--ink); border-radius: 16px; box-shadow: 0 10px 0 -4px rgb(35 32 26 / 0.14); }
  .jb-eyebrow { margin: 0 0 6px; font: 500 11px/1.2 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--green); }
  .jb-sec h2 { margin: 0; font: 480 34px/1.05 var(--serif); font-variation-settings: "SOFT" 100, "WONK" 1; letter-spacing: -0.02em; }
  .jb-quote { margin: 16px 0 0; padding: 0 0 0 16px; border-left: 3px solid #ffc93c; font: 500 27px/1.12 var(--hand); color: #2b2720; transform: rotate(-0.6deg); text-wrap: balance; }
  .jb-body { margin: 16px 0 0; font-size: 15.5px; line-height: 1.55; color: #2b2720; max-width: 56ch; }
  .jb-where { display: flex; gap: 7px; align-items: flex-start; margin: 18px 0 0; font-size: 13px; line-height: 1.45; color: #4a453a; }
  .jb-colophon { margin: 14px 0 0; font: 400 11px/1.4 var(--mono); letter-spacing: 0.02em; color: #6b6555; }
  .jb-colophon a { text-decoration: underline; text-decoration-color: var(--hair); text-underline-offset: 3px; }
  .jb-colophon a:hover { color: var(--green); text-decoration-color: var(--green); }
  .jb-where svg { width: 16px; height: 16px; flex: none; margin-top: 1px; fill: none; stroke: #c4391f; stroke-width: 1.8; stroke-linejoin: round; }
  .jb-where a, .jb-co a, .jb-notes a { text-decoration: underline; text-decoration-color: var(--green); text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  .jb-where a:hover, .jb-co a:hover, .jb-address a:hover { color: var(--green); }
  .jb-where i, .jb-co i, .jb-address i { font-style: normal; color: var(--green); }
  .jb-facts { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 20px 0 0; padding: 0; }
  .jb-facts li { padding: 10px 12px 11px; border: 1.5px solid var(--ink); border-radius: 12px; background: #fff; }
  .jb-facts li:nth-child(1) { background: #ffe9a8; transform: rotate(-1.2deg); } .jb-facts li:nth-child(2) { background: #c9f1e6; transform: rotate(0.8deg); } .jb-facts li:nth-child(3) { background: #ffd3c6; transform: rotate(-0.5deg); } .jb-facts li:nth-child(4) { background: #d8e4fb; transform: rotate(0.9deg); }
  .jb-facts b { display: block; font: 480 30px/1 var(--serif); font-variation-settings: "SOFT" 100, "WONK" 1; }
  .jb-facts span { display: block; margin-top: 4px; font: 400 11px/1.3 var(--mono); color: #3a352b; }

  /* the notebook — without JS it is simply every role, in order, on one card */
  .jb-book { position: relative; z-index: 6; max-width: 720px; margin: 18px auto 0; padding: 24px 24px 26px; background: var(--cream); border: 1.5px solid var(--ink); border-radius: 16px; box-shadow: 0 10px 0 -4px rgb(35 32 26 / 0.14); outline: none; }
  .jb-bk-head h2 { margin: 0; font: 480 34px/1.05 var(--serif); font-variation-settings: "SOFT" 100, "WONK" 1; letter-spacing: -0.02em; }
  .jb-bk-head h2 span { font: 500 25px/1 var(--hand); letter-spacing: 0; color: #a3391f; white-space: nowrap; }
  .jb-marks, .jb-turn, .jb-pageno, .jb-leaf, .jb-lid, .jb-cast, .jb-aside, .jb-doodle, .jb-hint, .jb-dock, .jb-ptab, .jb-flutter { display: none; }
  .jb-spread { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--hair); }
  .jb-folio { margin: 0 0 6px; display: flex; align-items: baseline; gap: 6px; color: var(--green); }
  .jb-no { font: 500 12px/1 var(--mono); letter-spacing: 0.06em; }
  .jb-numeral { font: 400 40px/0.9 var(--serif); font-variation-settings: "SOFT" 100, "WONK" 1; }
  .jb-spread h3, .jb-leaf-in h3 { margin: 0; font: 480 26px/1.1 var(--serif); font-variation-settings: "SOFT" 100, "WONK" 1; letter-spacing: -0.015em; text-wrap: balance; }
  .jb-spread h3 .jb-w, .jb-leaf-in h3 .jb-w { display: inline-block; }
  .jb-co { margin: 8px 0 0; font-size: 16px; }
  .jb-period { margin: 5px 0 0; font: 400 12.5px/1.4 var(--mono); color: #5a5447; }
  .jb-ruler { display: block; width: min(100%, 320px); margin: 16px 0 0 -8px; overflow: visible; }
  .jb-ruler-line { fill: none; stroke: var(--ink); stroke-width: 1.2; stroke-linecap: round; }
  .jb-ruler-mark { fill: none; stroke: #f2b632; stroke-width: 13; stroke-linecap: round; opacity: 0.9; }
  .jb-ruler text { font: 400 10px var(--mono); fill: #5a5447; }
  .jb-scribble { display: flex; align-items: center; gap: 8px; margin: 12px 0 0; font: 500 22px/1 var(--hand); color: #a3391f; transform: rotate(-2deg); transform-origin: left; }
  .jb-scribble svg { width: 44px; height: 14px; flex: none; } .jb-scribble path, .jb-doodle path { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .jb-pg-r { margin-top: 14px; }
  .jb-built { margin: 0 0 0; font: 500 11px/26px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--green); }
  .jb-notes { list-style: none; margin: 0; padding: 0 0 0 26px; font-size: 14.5px; line-height: 26px; color: #2b2720; }
  .jb-notes li { position: relative; margin: 0 0 13px; } .jb-notes li:last-child { margin-bottom: 0; }
  .jb-notes li::before { content: "~"; position: absolute; left: -24px; width: 18px; text-align: center; font: 700 21px/26px var(--hand); color: #c4391f; }
  .jb-notes strong { font-weight: 560; background: linear-gradient(transparent 56%, #ffe08a 56% 94%, transparent 94%); }

  .jb-stack-lede { margin: 6px 0 0; font-size: 15px; line-height: 1.45; color: #2b2720; }
  .jb-bag { margin: 12px 0 0; display: grid; gap: 11px 22px; }
  .jb-bag > div { position: relative; padding-left: 16px; }
  .jb-bag > div::before { content: ""; position: absolute; left: 0; top: 5px; bottom: 3px; width: 6px; border-radius: 3px; background: var(--tab); border: 1.5px solid var(--ink); }
  .jb-bag dt { font: 700 23px/1 var(--hand); color: var(--ink); }
  .jb-bag dt small { display: block; margin-top: 5px; font: 500 13px/1.35 var(--sans, "Geist", system-ui, sans-serif); color: #4a4438; }
  .jb-bag dd { margin: 6px 0 0; }
  .jb-bag ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 5px 6px; }
  .jb-bag li { padding: 3px 9px; border: 1.5px solid var(--ink); border-radius: 999px; background: #fffdf6; font-size: 13px; line-height: 1.35; color: #23201a; white-space: nowrap; }
  .jb-bag > .jb-bag-feat { grid-column: 1 / -1; padding: 11px 16px 12px; border: 1.5px solid var(--ink); border-radius: 14px; background: color-mix(in srgb, var(--tab) 26%, #fffdf6); box-shadow: 3px 3px 0 var(--ink); }
  .jb-bag > .jb-bag-feat::before { display: none; }
  .jb-bag > .jb-bag-feat dt { font-size: 28px; }
  .jb-bag .jb-caps { display: grid; grid-template-columns: 1fr; gap: 5px 22px; margin-top: 8px; }
  .jb-bag .jb-caps li { position: relative; padding: 0 0 0 20px; border: 0; border-radius: 0; background: none; white-space: normal; font: 600 15.5px/1.28 var(--sans); letter-spacing: -0.01em; color: var(--ink); }
  .jb-bag .jb-caps li::before { content: ""; position: absolute; left: 0; top: 0.42em; width: 10px; height: 10px; border-radius: 3px; background: var(--tab); border: 1.5px solid var(--ink); transform: rotate(8deg); }
  .jb-bag .jb-sets { margin: 10px 0 0; padding-top: 9px; border-top: 1.5px dashed color-mix(in srgb, var(--ink) 35%, transparent); display: grid; grid-template-columns: 1fr; gap: 8px 22px; }
  .jb-bag .jb-sets dt { font: 600 10.5px/1.2 var(--mono, "Geist Mono", monospace); letter-spacing: 0.09em; text-transform: uppercase; color: #5a5245; }
  .jb-bag .jb-sets dd { margin: 3px 0 0; font-size: 13.5px; line-height: 1.4; font-weight: 500; color: #23201a; }
  .jb-sign { margin: 18px 0 0; font: 500 22px/1 var(--hand); color: var(--green); transform: rotate(-1.5deg); transform-origin: left; }

  .jb-stamps { float: right; display: flex; align-items: flex-start; margin: -4px -4px 4px 12px; }
  .jb-stamp { width: 64px; transform: rotate(3deg); }
  .jb-postmark { width: 92px; margin-right: -22px; margin-top: 8px; transform: rotate(-14deg); color: #2c5c8f; opacity: 0.85; position: relative; z-index: 1; }
  .jb-postmark circle, .jb-postmark path { fill: none; stroke: currentColor; stroke-width: 1.6; }
  .jb-postmark text { font: 600 8.6px var(--mono); letter-spacing: 0.08em; fill: currentColor; }
  .jb-letter { margin: 14px 0 0; font: 500 24px/1.15 var(--hand); color: #2b2720; max-width: 30ch; }
  .jb-address { list-style: none; clear: both; margin: 14px 0 0; padding: 0; }
  .jb-address li { display: grid; grid-template-columns: 78px 1fr auto; align-items: center; gap: 0 8px; min-height: 44px; border-bottom: 1px solid rgb(35 32 26 / 0.35); }
  .jb-address li > span { font: 400 11px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: #5a5447; }
  .jb-address a { font-size: 15px; text-decoration: none; overflow-wrap: anywhere; padding: 8px 0; } .jb-address a:hover { text-decoration: underline; }
  .jb-copy { display: none; }
  html.js .jb-copy { all: unset; box-sizing: border-box; cursor: pointer; padding: 6px 11px 7px; border: 1.5px solid var(--ink); border-radius: 999px; background: #fff; font: 500 11.5px/1 var(--mono); transition: transform 0.2s var(--spring), background-color 0.15s; }
  html.js .jb-copy:hover { background: #ffe9a8; transform: rotate(-2deg) scale(1.04); }
  html.js .jb-copy.ok { background: #c9f1e6; }

  @media (min-width: 720px) {
    .jb-id { top: 26px; left: 36px; right: 36px; }
    .jb-id h1 { max-width: calc(100% - 200px); }
    .jb-now { display: flex; }
    .jb-meta { margin-top: 14px; font-size: 12px; }
    .jb-top { top: 28px; right: 32px; flex-direction: row; align-items: center; gap: 22px; }
    .jb-lang { margin-right: 0; font-size: 12px; }
    .jb-hello { font-size: 18px; padding: 14px 26px; }
    .jb-bag { grid-template-columns: 1fr 1fr; }
    .jb-bag .jb-caps, .jb-bag .jb-sets { grid-template-columns: 1fr 1fr; }
  }

  /* ── with JS: the page is one screen and the sections become one sheet of paper ── */
  html.js .jb-panel { position: fixed; z-index: 20; top: 26px; bottom: 74px; right: clamp(18px, 3vw, 56px); width: min(56vw, 540px); max-width: none; height: fit-content; max-height: calc(100svh - 100px); margin: auto 0; visibility: hidden; opacity: 0; pointer-events: none; }
  html.js .jb-panel.is-open { visibility: visible; opacity: 1; pointer-events: auto; }
  html.js .jb-paper { display: flex; flex-direction: column; max-height: calc(100svh - 100px); transform: rotate(-0.7deg); background: var(--cream); border: 1.5px solid var(--ink); border-radius: 16px; overflow: hidden; box-shadow: 0 2px 0 rgb(60 40 10 / 0.28), 0 22px 30px -14px rgb(70 45 10 / 0.55); }
  html.js .jb-paper::before { content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none; mix-blend-mode: multiply; opacity: 0.28;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.4  0 0 0 0 0.32  0 0 0 0 0.2  0 0 0 0.8 -0.25'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>"); }
  html.js .jb-scroll { overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #cfc5ab transparent; }
  html.js .jb-sec { margin: 0; padding: 30px 34px 32px; background: none; border: 0; border-radius: 0; box-shadow: none; }
  html.js .jb-sec[hidden] { display: none; }
  html.js .jb-sec h2 { padding-right: 44px; }
  html.js .jb-close { all: unset; box-sizing: border-box; position: absolute; z-index: 4; top: 14px; right: 14px; width: 40px; height: 40px; display: grid; place-items: center; cursor: pointer; border: 1.5px solid var(--ink); border-radius: 50%; background: #fff; font: 500 15px/1 var(--sans); transition: transform 0.25s var(--spring), background-color 0.15s; }
  html.js .jb-close:hover { background: #ffd3c6; transform: rotate(90deg) scale(1.06); }
  html.js .jb-s-contact .jb-stamps { margin-right: 44px; }
  html.js .jb-s-contact { background: linear-gradient(90deg, transparent 0, transparent 100%), repeating-linear-gradient(135deg, #f0583a 0 12px, transparent 12px 24px, #1d6fb8 24px 36px, transparent 36px 48px) top / 100% 7px no-repeat; }
  html.js[data-panel] .jb-hello, html.js[data-panel] .jb-lang { opacity: 0; visibility: hidden; }

  @media (min-width: 1100px) {
    html.js .jb-panel { width: min(45vw, 660px); }
  }
  /* ── desktop: the notebook lifts off the towel and lies open over the beach ── */
  @media (min-width: 820px) {
    html.js .jb-book { position: fixed; z-index: 20; inset: 70px clamp(18px, 2.4vw, 44px) 80px auto; width: min(980px, 66vw); height: min(640px, calc(100svh - 150px)); max-width: none; margin: auto 0; padding: 0; background: none; border: 0; border-radius: 0; box-shadow: none; visibility: hidden; opacity: 0; pointer-events: none; }
    html.js .jb-book.is-open { visibility: visible; opacity: 1; pointer-events: auto; }
    html.js .jb-book.is-leaving { pointer-events: none; }
    html.js .jb-bk-head { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    html.js .jb-bk-grab { display: none; }
    html.js .jb-tilt { position: absolute; inset: 0; transform: rotate(-0.8deg); }
    html.js .jb-board { position: absolute; inset: 0; padding: 9px 10px 10px; background: #1d4e89; border: 1.5px solid var(--ink); border-radius: 16px; box-shadow: 0 2px 0 rgb(60 40 10 / 0.28), 0 26px 34px -14px rgb(50 30 5 / 0.6); }
    html.js .jb-leaves { position: relative; height: calc(100% - 6px); border: 1.5px solid var(--ink); border-radius: 9px; perspective: 2200px;
      background: linear-gradient(90deg, #f6f0df 0, #fbf7ec 8%, #fbf7ec 44%, #ece4cf 48.6%, #cfc5ab 50%, #ece4cf 51.4%, #fbf7ec 56%, #fbf7ec 92%, #f6f0df 100%);
      box-shadow: 0 3px 0 0 #f1ead7, 0 3px 0 1.5px var(--ink), 0 6px 0 0 #f1ead7, 0 6px 0 1.5px var(--ink); }
    html.js .jb-leaves::after { content: ""; position: absolute; inset: 0; z-index: 7; border-radius: 8px; pointer-events: none; mix-blend-mode: multiply; opacity: 0.22;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.4  0 0 0 0 0.32  0 0 0 0 0.2  0 0 0 0.8 -0.25'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>"); }
    /* bookmark tabs: one per role, sticking out of the top edge; the open one is pulled out further */
    html.js .jb-marks { display: flex; position: absolute; z-index: -1; left: 34px; right: 74px; top: -47px; height: 62px; gap: 5px; align-items: flex-start; transition: opacity 0.2s ease, translate 0.35s var(--spring); }
    html.js .jb-mark { all: unset; box-sizing: border-box; flex: 0 1 auto; min-width: 0; max-width: 200px; height: 62px; padding: 6px 13px 0; cursor: pointer; display: grid; align-content: start; gap: 1px; background: var(--c); color: var(--ink); border: 1.5px solid var(--ink); border-bottom: 0; border-radius: 9px 9px 0 0; box-shadow: inset 0 -14px 10px -8px rgb(50 30 5 / 0.25); transform: translateY(9px); transition: transform 0.3s var(--spring); }
    html.js .jb-mark:hover { transform: translateY(3px); }
    html.js .jb-mark[aria-selected="true"] { transform: translateY(-5px); }
    html.js .jb-mark:focus-visible { outline: 2.5px solid #fffdf4; outline-offset: 1px; box-shadow: 0 0 0 5px var(--ink); }
    .jb-mark-c { font: 620 13px/1.2 var(--sans); letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .jb-mark-y { font: 400 10px/1.1 var(--mono); white-space: nowrap; }
    html.js .jb-book.jb-opening .jb-marks, html.js .jb-book.jb-closing .jb-marks { opacity: 0; translate: 0 26px; transition: none; }
    html.js .jb-bk-close { top: -18px; right: -14px; z-index: 8; box-shadow: 0 3px 0 -1px rgb(50 30 5 / 0.35); }
    html.js .jb-book.jb-opening .jb-bk-close, html.js .jb-book.jb-closing .jb-bk-close { opacity: 0; }

    html.js .jb-spread { position: absolute; inset: 0; margin: 0; padding: 0; border: 0; display: grid; grid-template-columns: 1fr 1fr; }
    html.js .jb-spread[hidden] { display: none; }
    html.js .jb-pg { min-height: 0; min-width: 0; }
    html.js .jb-pg-l { position: relative; display: flex; flex-direction: column; padding: clamp(20px, 4.2vh, 40px) 30px 58px 38px; overflow: hidden; }
    html.js .jb-pg-r { margin: 22px 8px 22px 0; padding: 0 22px 10px 58px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #cfc5ab transparent; background-attachment: local;
      -webkit-mask-image: linear-gradient(#000 calc(100% - 22px), transparent); mask-image: linear-gradient(#000 calc(100% - 22px), transparent);
      background-image: linear-gradient(90deg, transparent 39px, rgb(232 105 74 / 0.5) 39px 40px, transparent 40px), repeating-linear-gradient(transparent 0 25px, rgb(31 122 108 / 0.2) 25px 26px); }
    html.js .jb-pg-r::-webkit-scrollbar { width: 6px; } html.js .jb-pg-r::-webkit-scrollbar-thumb { background: #cfc5ab; border-radius: 3px; }
    html.js .jb-pg-r:focus-visible { outline-offset: 0; }
    html.js .jb-notes { padding: 0; } html.js .jb-notes li { margin-bottom: 26px; } html.js .jb-notes li::before { left: -36px; }
    html.js .jb-numeral { font-size: clamp(52px, 10vh, 98px); }
    html.js .jb-spread h3, html.js .jb-leaf-in h3 { font-size: clamp(26px, 2.7vw, 40px); margin-top: 8px; }
    html.js .jb-ruler { width: min(100%, 380px); margin-top: 22px; }
    html.js .jb-co { font-size: 17.5px; margin-top: 10px; }
    html.js .jb-aside { display: block; margin: 8px 0 0 auto; padding-right: 4px; font: 500 23px/1 var(--hand); color: #24655a; transform: rotate(-4deg); }
