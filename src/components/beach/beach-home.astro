          g.mode = "leave";
          g.t = 0;
          // Keep the flying sprite visible until it has cleared the viewport.
          g.x0 = g.dir > 0 ? fit.left + fit.width + 96 : fit.left - 96;
          g.y0 = g.y - 300;
