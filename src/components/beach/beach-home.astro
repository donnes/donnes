    if (!host) return;
    const btn = btnFor(id);
    if (openId === id) return closePanel();
    stopHint();
    if (openId) {
      const oldHost = hostOf(openId);
      const oldBtn = btnFor(openId);
      oldBtn?.setAttribute("aria-expanded", "false");
      if (oldHost === host) tuckGhost(oldBtn);
      else if (oldHost) animateOut(oldHost, oldBtn);
    }
    stopAnims(host);
    host.classList.remove("is-leaving", "jb-closing", "jb-opening");
    host.style.transform = "";
    openId = id;
    if (host === panel) {
      if (!sheetMq.matches) delete panel.dataset.open; // desktop: always re-inked
      fillPanel(id);
      const sc = q(".jb-scroll", panel);
      if (sc) sc.scrollTop = 0;
    }
    host.dataset.open = id;
    host.inert = false;
    host.classList.add("is-open");
    holdScene(true);
    root.dataset.panel = id;
    btn?.setAttribute("aria-expanded", "true");
    dockBtns.forEach((d) => (d.dataset.go === id ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
    if (host === book) {
      paint(active);
      if (leaves && sheetMq.matches) leaves.scrollTop = 0;
    }
    if (calm.matches) {
      if (host === book) show(active);
    } else if (host === book && !sheetMq.matches && lid) {
      // the paperback grows out of the towel, then its cover swings open
      show(active, false);
      host.classList.add("jb-opening");
      const from = tucked(host, btn);
      const grow = host.animate([from, { opacity: 1, offset: 0.4 }, { transform: "none", opacity: 1 }], { duration: 400, easing: SPRING });
      const cover = coverAnims(true, 170, 600);
      live2.set(host, [grow, ...cover]);
      if (cover[0])
        cover[0].onfinish = () => {
          stopAnims(host);
          host.classList.remove("jb-opening");
          show(active);
          spreads[active].classList.add("jb-turned");
        };
    } else if (sheetMq.matches) {
      // phones: the sheet is already laid out and painted below the screen — a plain slide up, transform only, no overshoot
      if (host === book) show(active, false);
      live2.set(host, [host.animate([{ transform: "translateY(100%)" }, { transform: "none" }], { duration: 300, easing: "cubic-bezier(.2,.8,.2,1)" })]);
    } else {
      if (host === book) show(active);
      const from = tucked(host, btn);
      live2.set(host, [host.animate([from, { opacity: 1, offset: 0.4 }, { transform: "none", opacity: 1 }], { duration: 340, easing: SPRING })]);
    }
    if (focus) (host === book ? marks[active] ?? host : host).focus({ preventScroll: true });
    history.replaceState(null, "", `${location.pathname}${location.search}#${id}`);
  }
  function closePanel(returnFocus = true) {
    const host = hostOf(openId);
    if (!host || !openId) return;
    const btn = btnFor(openId);
    const hadFocus = host.contains(document.activeElement) || dockBtns.includes(document.activeElement as HTMLButtonElement);
    btn?.setAttribute("aria-expanded", "false");
    openId = null;
    delete root.dataset.panel;
    history.replaceState(null, "", `${location.pathname}${location.search}`);
    if (returnFocus && hadFocus) btn?.focus({ preventScroll: true });
    animateOut(host, btn);
  }
  openers.forEach((b) => b.addEventListener("click", () => openPanel(b.dataset.open || "")));
  openers.forEach((b) => b.addEventListener("pointerdown", () => sheetMq.matches && !openId && b.dataset.open !== "work" && fillPanel(b.dataset.open || ""), { passive: true }));
  for (const h of [panel, book]) if (h) h.inert = true;
  dockBtns.forEach((d) => d.addEventListener("click", () => d.dataset.go !== openId && openPanel(d.dataset.go || "")));
  qa(".jb-close").forEach((c) => c.addEventListener("click", () => closePanel()));
  document.addEventListener("keydown", (e) => {
    if (!openId) return;
    if (e.key === "Escape") {
      e.preventDefault();
      const btn = btnFor(openId);
      closePanel(false);
      btn?.focus({ preventScroll: true });
    } else if (openId === "work" && !e.metaKey && !e.ctrlKey && !e.altKey) {
      const onMark = marks.includes(document.activeElement as HTMLButtonElement);
      const to = ({ ArrowRight: active + 1, ArrowLeft: active - 1, PageDown: active + 1, PageUp: active - 1, Home: 0, End: spreads.length - 1 } as Record<string, number>)[e.key];
      if (to === undefined || ((e.key === "Home" || e.key === "End" || e.key.startsWith("Page")) && !onMark)) return;
      e.preventDefault();
      selectRole(to, onMark);
    }
  });
  // clicking the beach puts things back
  document.addEventListener("pointerdown", (e) => {
    if (!openId) return;
    const t = e.target as Element | null;
    if (t?.closest(".jb-panel, .jb-book, .jb-dock, .jb-obj, .jb-top")) return;
    closePanel(false);
  });
  // phones: drag a sheet down by its handle
  qa(".jb-grab").forEach((grab) => {
    const host = grab.closest<HTMLElement>(".jb-panel, .jb-book");
    if (!host) return;
    let y0 = 0, dy = 0, on = false;
    grab.addEventListener("pointerdown", (e) => {
      if (!sheetMq.matches) return;
      on = true;
      y0 = e.clientY;
      dy = 0;
      stopAnims(host);
      grab.setPointerCapture(e.pointerId);
    });
    grab.addEventListener("pointermove", (e) => {
      if (!on) return;
      dy = Math.max(0, e.clientY - y0);
      host.style.transform = `translateY(${dy}px)`;
    });
    const end = () => {
      if (!on) return;
      on = false;
      if (dy > 90) return closePanel();
      if (dy > 0 && !calm.matches) live2.set(host, [host.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], { duration: 300, easing: SPRING })]);
      host.style.transform = "";
    };
    grab.addEventListener("pointerup", end);
    grab.addEventListener("pointercancel", end);
  });

  // contact: copy the address
  qa<HTMLButtonElement>(".jb-copy").forEach((btn) => {
    const label = q(".jb-copy-t", btn);
    let timer = 0;
    btn.addEventListener("click", async () => {
      let ok = true;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || "");
      } catch {
        ok = false;
      }
      if (label) label.textContent = ok ? T.copied : T.copyFailed;
      btn.classList.toggle("ok", ok);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = T.copy;
        btn.classList.remove("ok");
      }, 1800);
    });
  });

  // Trace the actual SVG geometry, including shared layers and every beach object.
  // The temporary, inert drawing stays aligned with the paused color scene.
  if (introPending) {
    const draft = document.createElement("div");
    draft.className = "jb-draft";
    draft.dataset.phase = "prepare";
    draft.setAttribute("aria-hidden", "true");
    draft.inert = true;
    const paint = document.createElement("div");
    paint.className = "jb-draft-paint";
    if (LITE) paint.style.opacity = "0"; // Keep preparation behind the paper; canvas supplies the visible ink.
    const drawingSources = [scene, q(".jb-objs"), q("#habitat-sign"), ...qa(".jb-fg")].filter((el): el is HTMLElement => !!el);
    for (const source of LITE ? [] : drawingSources) {
      if (!source) continue;
      const copy = source.cloneNode(true) as Element;
      for (const el of [copy, ...qa<Element>("*", copy)]) {
        el.removeAttribute("id");
        el.removeAttribute("aria-controls");
      }
      paint.append(copy);
    }
    // Expand <use> instances so each contour can receive a normalized pencil stroke.
    // Keep the original definitions for clip paths, but never duplicate their IDs.
    const expandUses = (host: Element, depth = 0) => {
      if (depth > 8) return;
      for (const use of qa<SVGUseElement>("use", host)) {
        const href = use.getAttribute("href") || use.getAttribute("xlink:href");
        if (!href?.startsWith("#")) continue;
        const source = document.getElementById(href.slice(1));
        if (!source) continue;
        const group = document.createElementNS("http://www.w3.org/2000/svg", "g");
        for (const attr of [...use.attributes]) {
          if (!["href", "xlink:href", "x", "y", "id"].includes(attr.name)) group.setAttribute(attr.name, attr.value);
        }
        const offset = document.createElementNS("http://www.w3.org/2000/svg", "g");
        offset.setAttribute("transform", `translate(${use.getAttribute("x") || 0} ${use.getAttribute("y") || 0})`);
        const geometry = source.cloneNode(true) as Element;
        for (const el of [geometry, ...qa<Element>("[id]", geometry)]) el.removeAttribute("id");
        offset.append(geometry);
        group.append(offset);
        expandUses(group, depth + 1);
        use.replaceWith(group);
      }
    };
    expandUses(paint);
    draft.append(paint);
    q(".jb-world")?.append(draft);
    root.classList.add("jb-draft-ready");
    // Release the descendant CSS pause while paper still covers the scene. Keep the
    // animation objects paused so the final handoff needs no whole-scene restyle.
    const pausedScene = document.getAnimations().filter(animation => {
      const target = (animation.effect as KeyframeEffect | null)?.target;
      return target instanceof Element && !draft.contains(target) && drawingSources.some(source => source.contains(target));
    });
    pausedScene.forEach(animation => animation.pause());
    root.classList.add("jb-intro-prepared");

    const contours = (LITE ? drawingSources.flatMap(source => qa<SVGGeometryElement | SVGUseElement | SVGTextElement>("path, rect, circle, ellipse, line, polyline, polygon, use, text", source)) : qa<SVGGeometryElement>("path, rect, circle, ellipse, line, polyline, polygon", paint))
      .filter((el) => !el.closest("defs, clipPath, mask"));
    const drawings = qa<SVGSVGElement>("svg", paint);
    if (!LITE) {
      // Read styles together before writing, so conversion does not repeatedly force layout.
      const fills = contours.map((el) => getComputedStyle(el).fill);
      contours.forEach((el, i) => {
        el.setAttribute("pathLength", "1");
        el.style.setProperty("fill", fills[i] === "none" ? "none" : "#f5f0e5", "important");
        el.style.setProperty("stroke", "#777166", "important");
        el.style.setProperty("stroke-width", "0.8px", "important");
        el.style.setProperty("stroke-linecap", "round", "important");
        el.style.setProperty("stroke-linejoin", "round", "important");
        el.style.setProperty("stroke-dasharray", "1", "important");
        el.style.setProperty("stroke-dashoffset", "inherit", "important");
        el.setAttribute("vector-effect", "non-scaling-stroke");
      });
      drawings.forEach((svg) => { svg.style.strokeDashoffset = "1"; });
    }
    let drawingRaf = 0;
    let drawingTime = 0;
    let drawingLast = 0;
    const strokes: Animation[] = [];
    let reveal: Animation | undefined;
    const finishIntro = () => {
      if (!introPending) return;
      introPending = false;
      cancelAnimationFrame(drawingRaf);
      draft.remove();
      reveal?.cancel();
      strokes.forEach((stroke) => stroke.cancel());
      root.classList.add("jb-intro-done");
      if (!held && !document.hidden && !calm.matches) pausedScene.forEach(animation => animation.play());
      window.removeEventListener("resize", resizeIntro);
      calm.removeEventListener("change", finishIntro);
      document.removeEventListener("visibilitychange", syncReveal);
      syncRunning();
      update();
      rates();
    };
    const syncReveal = () => {
      drawingLast = 0;
      for (const animation of [...strokes, ...(reveal ? [reveal] : [])]) {
        if (document.hidden) animation.pause();
        else animation.play();
      }
    };
    const introWidth = measuredWidth, introHeight = measuredHeight;
    const resizeIntro = () => {
      if (scene?.clientWidth !== introWidth || scene?.clientHeight !== introHeight) finishIntro();
    };
    window.addEventListener("resize", resizeIntro);
    calm.addEventListener("change", finishIntro, { once: true });
    document.addEventListener("visibilitychange", syncReveal);
    // Trace contours in overlapping passes, then let the paint show through.
    // One animation per SVG inherits down to its paths, rather than one per contour.
    const fadeToPaint = () => {
      draft.dataset.phase = "color";
      reveal = draft.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 700, easing: "ease", fill: "both",
      });
      syncReveal();
      void reveal.finished.then(finishIntro, finishIntro);
    };
    if (LITE) {
      void prepareBeachDrawing(root, contours, measuredWidth, measuredHeight).then(({ canvas, draw }) => {
        if (!introPending) return;
        paint.replaceWith(canvas);
        const trace = (now: number) => {
          if (!introPending) return;
          if (!document.hidden && drawingLast) drawingTime += Math.min(50, now - drawingLast);
          drawingLast = now;
          if (drawingTime > 0 && draft.dataset.phase !== "drawing") draft.dataset.phase = "drawing";
          draw(drawingTime);
          if (drawingTime >= 1350) fadeToPaint();
          else drawingRaf = requestAnimationFrame(trace);
        };
        drawingRaf = requestAnimationFrame(trace);
      }).catch(finishIntro);
    } else requestAnimationFrame(() => requestAnimationFrame(() => {
      if (!introPending) return;
      draft.dataset.phase = "drawing";
      drawings.forEach((svg, i) => {
        strokes.push(svg.animate([{ strokeDashoffset: "1" }, { strokeDashoffset: "0" }], {
          duration: 900, delay: (i / Math.max(1, drawings.length - 1)) * 450,
          easing: "linear", fill: "both",
        }));
      });
      void Promise.all(strokes.map(stroke => stroke.finished)).then(() => {
        if (introPending) fadeToPaint();
      }, finishIntro);
      syncReveal();
    }));
  }

  const wanted = location.hash.slice(1) || params.get("p") || "";
  if (btnFor(wanted)) openPanel(wanted, false);
</script>
