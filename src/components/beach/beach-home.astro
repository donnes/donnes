  .jb-bag li { padding: 3px 9px; border: 1.5px solid var(--ink); border-radius: 999px; background: #fffdf6; font-size: 13px; line-height: 1.35; color: #23201a; white-space: nowrap; }
  .jb-bag > .jb-bag-feat { grid-column: 1 / -1; padding: 11px 16px 12px; border: 1.5px solid var(--ink); border-radius: 14px; background: color-mix(in srgb, var(--tab) 26%, #fffdf6); box-shadow: 3px 3px 0 var(--ink); }
