<script>
  import { prepareBeachDrawing } from "../../lib/beach-drawing";
  import { SHORE, HORIZON, yAt } from "../../lib/beach/shore";
  import { createScene, type Env, type Sky, type Phase, type SceneState } from "../../lib/beach/scene";
  import { createClock } from "../../lib/beach/clock";
  import { createGull } from "../../lib/beach/gull";
  import { createCrab } from "../../lib/beach/crab";
  import { createBall } from "../../lib/beach/ball";
  import { createBirds } from "../../lib/beach/birds";
  import { createSail } from "../../lib/beach/sail";
  import { createSky } from "../../lib/beach/sky";
  import { reportHabitat, recordHabitat, reportMatch } from "../../lib/habitat/display";
  import { createMatch, awardPoint, landingWinner, faultWinner, other, type Player, type PointReason } from "../../lib/habitat/match";
  import { LOCAL_TENNIS, parseTennis, chooseShot } from "../../lib/habitat/tennis";
  import { fallback, parsePlan, allowed, type Action, type Context } from "../../lib/habitat/plan";
  const root = document.documentElement;
  const q = <T extends Element = HTMLElement>(sel: string, p: ParentNode = document) => p.querySelector<T>(sel);
  const qa = <T extends Element = HTMLElement>(sel: string, p: ParentNode = document) => Array.from(p.querySelectorAll<T>(sel));
  const params = new URLSearchParams(location.search);
  // localized words for the chip and the copy button (see strings.ts → client)
  type Words = { phase: Record<string, string>; sky: Record<string, string>; code: Record<string, string>; windy: string; wind: string; compass: string[]; copy: string; copied: string; copyFailed: string };
  const T: Words = JSON.parse(document.getElementById("jb-strings")?.textContent || "{}");
  if (params.get("og")) root.setAttribute("data-og", ""); // the Open Graph capture: no preview badge, hint or language switch
  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  qa<HTMLAnchorElement>('.jb-notes a[target="_blank"]').forEach((a) => (a.rel = "noopener"));
  const sheetMq = window.matchMedia("(max-width: 819px)");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  // LITE — the one switch for the cheap scene (phones, tablets, narrow windows). Mirrors `html.is-lite`, which the inline
  // script at the top of the body sets before first paint; both follow the same media query.
  const liteMq = window.matchMedia("(max-width: 1100px), (pointer: coarse)");
  let LITE = liteMq.matches;
  root.classList.toggle("is-lite", LITE);

  /* ───────────── painting → screen mapping, and where the four things sit ───────────── */
  const sceneEl = q(".jb-scene");
  const NOT_FOUND = sceneEl?.dataset.nf != null; // the 404 beach: nobody plays and no AI is asked
  const scene = createScene({
    root, notFound: NOT_FOUND, random: Math.random,
    caps: { get lite() { return LITE; }, get calm() { return calm.matches; }, get sheet() { return sheetMq.matches; } },
  });
  const fit = scene.fit;
  const env = scene.env;
  const lum = scene.lum;
  const pointer = scene.pointer;
  const shoreY = (x: number) => yAt(SHORE, x);
  const placed = qa<HTMLButtonElement>(".jb-obj");
  let measuredWidth = 0, measuredHeight = 0;
  function measure() {
    // Match the painting's 100svh canvas, which stays put when mobile browser chrome moves.
    const viewportWidth = sceneEl?.clientWidth || window.innerWidth;
    const viewportHeight = sceneEl?.clientHeight || window.innerHeight;
    if (viewportWidth === measuredWidth && viewportHeight === measuredHeight) return false;
    measuredWidth = viewportWidth;
    measuredHeight = viewportHeight;
    const W = viewportWidth + 48;
    const H = viewportHeight + 48;
    fit.s = Math.max(W / 1600, H / 1000);
    fit.ox = (W - 1600 * fit.s) / 2 - 24;
    fit.oy = (H - 1000 * fit.s) / 2 - 24;
    fit.left = -fit.ox / fit.s;
    fit.width = viewportWidth / fit.s;
    fit.portrait = fit.width < 1100;
    const st = root.style;
    st.setProperty("--fs", fit.s.toFixed(4));
    st.setProperty("--ox", `${fit.ox.toFixed(1)}px`);
    st.setProperty("--oy", `${fit.oy.toFixed(1)}px`);
    st.setProperty("--hz", `${((H - 1000 * fit.s) / 2 + HORIZON * fit.s).toFixed(1)}px`);
    // a portrait screen only sees the middle of the painting: the things gather there, a little smaller
    const k = fit.portrait ? clamp(viewportWidth / 780, 0.46, 0.64) : clamp(fit.width / 1500, 0.78, 1);
    st.setProperty("--k", k.toFixed(3));
    const bottom = (viewportHeight - fit.oy) / fit.s; // painting-y of the screen's bottom edge
    for (const el of placed) {
      const d = el.dataset;
      const fx = Number(fit.portrait ? d.pfx : d.fx);
      const x = fit.left + fx * fit.width;
      const sh = fit.portrait ? d.pshore : d.shore;
      let y = sh ? shoreY(x) + Number(sh) : Number(d.y);
      if (fit.portrait && d.prow) {
        // two rows on the sand: towel + cooler along the bottom, the guarda-sol standing clear above them
        // Keep the foreground props below a full-width court on portrait screens.
        const screenY = d.prow === "bottom" ? viewportHeight - 54 : d.prow === "top" ? viewportHeight * 0.56 : viewportHeight - 80;
        y = (screenY - fit.oy) / fit.s;
      } else if (fit.portrait && el.classList.contains("jb-o-contact")) y = (viewportHeight * 0.56 - fit.oy) / fit.s;
      else y = Math.min(y, bottom - 84 / fit.s + (el.classList.contains("jb-ball") ? 30 : 0));
      el.style.setProperty("--x", x.toFixed(1));
      el.style.setProperty("--y", y.toFixed(1));
    }
    // the beach-tennis court lies further along the sand, parallel to the shore and clear of the biggest wave
    let cx = Math.min(fit.left + fit.width * 0.76, 1195); // …and of the palm fronds
    let cy = shoreY(cx) + 68;
    let ck = 0.8;
    if (fit.portrait) {
      // The court gets its own middle row, rather than shrinking into a leftover gap.
      cx = fit.left + fit.width * 0.44;
      ck = fit.width * 0.80 / 380;
      cy = (viewportHeight * 0.725 - fit.oy) / fit.s;
    }
    st.setProperty("--bt-x", cx.toFixed(1));
    st.setProperty("--bt-y", cy.toFixed(1));
    st.setProperty("--bt-k", ck.toFixed(3));
    st.setProperty("--hb-x", (fit.portrait ? fit.left + fit.width * 0.84 : cx + 205).toFixed(1));
    st.setProperty("--hb-y", (fit.portrait ? Math.min(cy - 8, (viewportHeight - 54 - 230 * k * fit.s - 86 - fit.oy) / fit.s) : cy - 8).toFixed(1));
    st.setProperty("--hb-w", (fit.portrait ? 90 / fit.s : 138).toFixed(1));
    if (NOT_FOUND) {
      // "404" sits on the open sand in front of the court: left of centre on a wide screen, a bottom row on a portrait one
      const nw = fit.portrait ? fit.width * 0.8 : clamp(fit.width * 0.44, 460, 680);
      st.setProperty("--nf-x", (fit.left + fit.width * (fit.portrait ? 0.5 : 0.4)).toFixed(1));
      st.setProperty("--nf-y", (fit.portrait ? (viewportHeight * 0.885 - fit.oy) / fit.s : Math.min(820, bottom - nw * 0.2 - 70 / fit.s)).toFixed(1));
      st.setProperty("--nf-w", nw.toFixed(1));
    }
    return true;
  }
  measure();
  root.classList.add("jb-ready");
  let resizeRaf = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(() => {
      if (!measure() || !scene.state) return;
      sky.placeLum();
      render();
    });
  });

  /* ───────────── one clock for everything that moves ───────────── */
  const clock = createClock({ random: Math.random });
  let introPending = root.classList.contains("jb-intro") && !calm.matches;
  let introBlending = false; // the paper is fading: the paint underneath is on show and must hold still
  let held = false; // lite phones: a sheet covers the beach, so the scene stops entirely (see holdScene)
  function syncRunning() {
    root.classList.toggle("is-asleep", document.hidden);
    clock.sync({ hidden: document.hidden, held, calm: calm.matches, intro: introPending });
  }
  function holdScene(on: boolean) {
    on = on && LITE && sheetMq.matches;
    if (on === held) return;
    held = on;
    // paused one by one rather than with a class on <html>: that would restyle the whole painting at the very moment a sheet starts to move
    const parts = [sceneEl, q(".jb-objs"), q(".jb-rainsky"), ...qa(".jb-fg")];
    for (const a of document.getAnimations?.() ?? []) {
      const el = (a.effect as KeyframeEffect | null)?.target;
      if (a instanceof CSSTransition || !el || !parts.some((p) => p?.contains(el))) continue;
      if (on && a.playState === "running") a.pause();
      else if (!on && a.playState === "paused") a.play();
    }
    syncRunning();
  }
  document.addEventListener("visibilitychange", syncRunning);
  calm.addEventListener("change", syncRunning);

  /* ───────────── palette: six gouache boxes keyed along the day, blended in JS (stepped, never per-frame) ───────────── */
  const BOXES = ["dawn", "morning", "day", "golden", "dusk", "night"] as const;
  type BoxName = (typeof BOXES)[number] | "aft";
  type Pal = { c: number[][]; n: number[] };
  const COLS = ["--sky-0", "--sky-1", "--sky-2", "--sky-3", "--cloud", "--cloud-shade", "--cloud-hi", "--sun", "--halo", "--far-1", "--far-2", "--sea-0", "--sea-1", "--sea-2", "--sea-3", "--sea-4", "--foam", "--glitter", "--veil"];
  const NUMS = ["--stars", "--lights"];
  // lite has no veil filter: the veiled layers' own paint is multiplied by the veil instead (same maths as the filter's feBlend)
  const LAND = ["--hill", "--hill-dk", "--hill-lt", "--sand", "--sand-lt", "--sand-dk", "--wet", "--dune", "--g1", "--g2", "--g3", "--straw", "--p-wall", "--p-roof-a", "--p-roof-b", "--p-speck-dk", "--p-speck-lt", "--p-starfish", "--p-shell", "--p-trunk", "--p-ring", "--p-seed"];
  const veiledEls = qa<HTMLElement | SVGElement>(".jb-veiled");
  let landBase: number[][] = [];
  let landKey = "";
  function paintLand(veil: number[]) {
    const key = LITE ? veil.map((v) => Math.round(v)).join() : "";
    if (key === landKey) return;
    landKey = key;
    LAND.forEach((k, i) => {
      const v = LITE ? rgb(landBase[i].map((c, ch) => (c * veil[ch]) / 255)) : "";
