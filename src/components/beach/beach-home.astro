    A.classList.remove("is-in", "is-new");
    B.classList.remove("is-in", "is-new");
    A.classList.add(fwd ? "jb-hide-r" : "jb-hide-l");
    B.classList.add(fwd ? "jb-hide-l" : "jb-hide-r");
