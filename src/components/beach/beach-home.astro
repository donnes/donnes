  .bt-face-line { fill: none; stroke: var(--v-hair-dark); stroke-width: 0.65; stroke-linecap: round; }
  .bt-smile { fill: none; stroke: var(--v-cream); stroke-width: 0.7; stroke-linecap: round; }
  .bt-lips { fill: none; stroke: var(--v-coral); stroke-width: 0.7; stroke-linecap: round; }
  .bt-leg, .bt-arm, .bt-body { transform-origin: 0 0; }
  .jb-bt-ball { width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: var(--v-orange); box-shadow: inset -1.5px -1.5px 0 rgb(80 30 0 / 0.22); opacity: 0; transition: opacity 0.4s ease; }
  .jb-bt-bsh { width: 10px; height: 3.4px; margin: -1.7px 0 0 -5px; border-radius: 50%; background: var(--v-shade); opacity: 0; transition: opacity 0.4s ease; }
