        if (habitat.action === "break") {
          if (P.every(p => Math.abs(p.tx - p.x) < 3)) habitat.resting = true;
          return;
        }
        if (P.some(p => Math.abs(p.tx - p.x) > 3)) return;
        changingEnds = false;
        wait -= dt;
        if (wait <= 0) toss(server);
      }
    });
  }

  /* ───────────── ?demo=1: walk through every weather × daytime, one state every ~6s ───────────── */
  if (params.get("demo")) {
