      x += (tx - x) * 0.07;
      y += (ty - y) * 0.07;
      for (const l of deep) l.el.style.translate = `${(-x * l.d).toFixed(2)}px ${(-y * l.d).toFixed(2)}px`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.05 ? requestAnimationFrame(step) : 0;
