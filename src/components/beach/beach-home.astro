    @keyframes jb-ff1 { 0%, 100% { transform: translate(0, 0); opacity: 0.1; } 20% { transform: translate(-40px, -30px); opacity: 1; } 45% { opacity: 0.1; } 60% { transform: translate(-16px, -90px); opacity: 0.95; } 80% { transform: translate(30px, -50px); opacity: 0; } }
    @keyframes jb-ff2 { 0%, 100% { transform: translate(0, 0); opacity: 0; } 25% { transform: translate(50px, -20px); opacity: 0.9; } 50% { transform: translate(70px, -70px); opacity: 0.15; } 70% { opacity: 1; } 85% { transform: translate(14px, -60px); opacity: 0; } }
