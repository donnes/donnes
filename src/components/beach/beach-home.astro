  .bt-port-royale { fill: var(--v-port-royale); } .o-char { fill: var(--v-char); }
  .bt-pink { fill: var(--v-pink); } .bt-skirt { fill: var(--v-pink-dark); }
  .bt-skirt-pleats { fill: none; stroke: var(--v-pink); stroke-width: 0.7; stroke-linecap: round; }
  .bt-ball-c { fill: var(--v-orange); }
  .jb-bt-pool { left: -180px; top: -44px; width: 360px; height: 96px; border-radius: 50%; background: radial-gradient(closest-side, rgb(255 206 120 / 0.5), transparent); opacity: calc(var(--lights, 0) * 0.6); }
