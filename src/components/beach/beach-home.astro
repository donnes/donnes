    return 1 + (min >= ss ? min - ss : min + 1440 - ss) / (1440 - (ss - sr));
  }
  function moonPath(): string {
    const forced = Number(params.get("moon")); // ?moon=0…1 previews a phase (0 new · 0.25 first quarter · 0.5 full)
    const p = params.get("moon") && Number.isFinite(forced) ? clamp(forced, 0, 0.999) : ((((Date.now() / 864e5 - 10962.76) % 29.530588) + 29.530588) % 29.530588) / 29.530588; // since the new moon of 2000-01-06
