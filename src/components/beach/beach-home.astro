  // a gull lands on the sand, hops about, and leaves (dry daylight only)
  const gull = q(".jb-gull");
  if (gull) {
    const g = { mode: "gone" as "gone" | "land" | "stand" | "hop" | "leave", x: 0, y: 0, x0: 0, y0: 0, t: 0, duration: 1.5, dir: 1, hops: 0, wait: 0 };
    const put = (x: number, y: number) => (gull.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) scaleX(${g.dir})`);
    inviteGull = () => {
      if (g.mode !== "gone" || LITE || lifeNow() < 0.8 || env.wind > 0.7) return;
      g.dir = Math.random() < 0.5 ? 1 : -1;
      g.x = fit.left + fit.width * rand(0.3, 0.68);
      g.y = shoreY(g.x) + rand(96, 130);
      g.x0 = g.x - g.dir * 260;
      g.y0 = g.y - 200;
      g.t = 0;
      g.duration = 1.5;
      g.hops = Math.floor(rand(3, 7));
      g.mode = "land";
      gull.classList.add("is-out", "is-air");
    };
    sometimes(24, 46, () => inviteGull(), 9);
    tasks.push((dt) => {
      if (g.mode === "gone") return;
      g.t += dt;
      if (g.mode === "land" || g.mode === "leave") {
        const k = clamp(g.t / g.duration, 0, 1);
        const u = g.mode === "land" ? 1 - (1 - k) * (1 - k) : 1 - k * k;
        put(g.x0 + (g.x - g.x0) * u, g.y0 + (g.y - g.y0) * u);
        if (k >= 1) {
          if (g.mode === "leave") {
            g.mode = "gone";
            gull.classList.remove("is-out", "is-air");
          } else {
            g.mode = "stand";
            g.wait = rand(0.8, 2);
            gull.classList.remove("is-air");
          }
        }
      } else if (g.mode === "stand") {
        g.wait -= dt;
        if (g.wait > 0) return;
