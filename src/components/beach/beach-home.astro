          c.wait = rand(1, 2.8);
          crab.classList.add("is-walking");
        }
        return;
      }
      c.phase += dt * 3;
      c.x += c.dir * 50 * dt;
      c.y = shoreY(c.x) + 72 + Math.sin(c.phase) * 7;
