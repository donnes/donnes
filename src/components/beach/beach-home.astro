        <span class="jb-art">
          <svg class="jb-idle" viewBox="0 0 380 400" aria-hidden="true" focusable="false">
            <ellipse class="o-shadow o-sh o-sh-umb" style="--sk:1.5" cx="215" cy="378" rx="150" ry="20"></ellipse>
