     the cost: no filters (the veil is baked into the land paint by the script), one wave, a handful of small sprites. */
  html.is-lite .jb-paintbox [filter], html.is-lite .jb-scene [filter], html.is-lite .jb-world [filter] { filter: none !important; }
  html.is-lite .jb-veiled { filter: none !important; }
