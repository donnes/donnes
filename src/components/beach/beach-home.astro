  const shoot = q(".jb-shoot");
  sometimes(14, 32, () => {
    if (!shoot || !root.hasAttribute("data-night") || env.cover > 0.35 || env.deck > 0.2) return;
    shoot.style.left = `${(fit.left + fit.width * rand(0.35, 0.95)).toFixed(0)}px`;
    shoot.style.top = `${rand(10, 110).toFixed(0)}px`;
