                })}
                <circle class="o-teal" cx="0" cy="-95" r="5.5"></circle>
              </g>
            </g>
            <g class="o-can-shut" filter="url(#wobS)">
              <path class="o-coral" d="M184 60Q166 150 195 252L211 250Q214 150 184 60Z"></path>
              <path class="o-cream" d="M184 60Q181 150 199 251L205 250.500Q198 150 184 60Z"></path>
              <path class="o-gold" d="M184 60Q204 150 208 250L211 250Q214 150 184 60Z"></path>
              <path class="o-strap" d="M190 204l21 -3"></path>
              <circle class="o-teal" cx="184" cy="57" r="7"></circle>
            </g>
          </svg>
          {[[17.3, 235.6], [103.5, 223.6], [189.6, 214], [275.7, 199.4], [361.9, 187.3]].map(([x, y], k) => <i class="jb-drip" style={`left:${f((x / 380) * 100)}%;top:${f((y / 400) * 100)}%;animation-delay:${f(-k * 0.47)}s`}></i>)}
        </span>
        <span class="jb-tag">{S.about.label}</span>
      </button>

      <button type="button" class="jb-obj jb-o-contact" style="--w:200;--i:2" data-open="contact" data-fx="0.565" data-shore="52" data-pfx="0.27" data-pshore="64" aria-haspopup="dialog" aria-expanded="false" aria-controls="jb-panel" aria-label={S.contact.aria}>
        <span class="jb-art">
          <svg class="jb-ride" viewBox="0 0 210 120" aria-hidden="true" focusable="false">
            <ellipse class="o-shadow wetsh" cx="108" cy="100" rx="86" ry="11"></ellipse>
            <g transform="rotate(-12 105 70)">
              <rect class="o-cork" x="181" y="62" width="17" height="16" rx="3"></rect>
              <path class="o-glass" d="M60 46H128Q146 46 158 60H184V80H158Q146 94 128 94H60Q38 94 38 70Q38 46 60 46Z"></path>
              <rect class="o-white" x="58" y="57" width="80" height="26" rx="12"></rect>
              <rect class="o-coral" x="94" y="56" width="9" height="28"></rect>
              <path class="o-glint" d="M62 53H124"></path>
            </g>
          </svg>
        </span>
        <span class="jb-tag">{S.contact.label}</span>
      </button>

      <button type="button" class="jb-obj jb-o-stack" style="--w:230;--i:3" data-open="stack" data-fx="0.735" data-y="842" data-pfx="0.76" data-prow="bottom" aria-haspopup="dialog" aria-expanded="false" aria-controls="jb-panel" aria-label={S.stack.aria}>
        <span class="jb-art">
          <svg class="jb-idle" viewBox="0 0 230 230" aria-hidden="true" focusable="false">
            <ellipse class="o-shadow o-sh" style="--sk:0.5" cx="126" cy="208" rx="108" ry="14"></ellipse>
            <g class="o-cool-open" filter="url(#wobS)">
              <path class="o-white" d="M42 96L192 96L210 30L60 22Z"></path>
              <path class="o-teal" d="M50 70L198 72L202 56L54 52Z"></path>
              <path class="o-dark" d="M28 112L202 112L190 92L42 92Z"></path>
              <path class="o-green" d="M70 112V58Q70 50 75 46V26H87V46Q92 50 92 58V112Z"></path>
              <rect class="o-gold" x="74" y="22" width="14" height="7" rx="2"></rect>
              <path class="o-amber" d="M102 112V70Q102 62 106 58V42H116V58Q120 62 120 70V112Z"></path>
              <ellipse class="o-gold" cx="158" cy="98" rx="24" ry="30"></ellipse>
              <path class="o-line dk" d="M142 84l32 24M174 84l-32 24M150 74l22 18M166 74l-22 18"></path>
              <path class="o-green" d="M158 70Q150 40 136 34Q152 40 157 56Q156 30 150 18Q164 32 162 56Q168 38 182 32Q170 46 166 70Z"></path>
            </g>
            <g filter="url(#wobS)">
              <path class="o-coral" d="M28 112H202L192 204Q191 210 184 210H46Q39 210 38 204Z"></path>
              <path class="o-cream" d="M31.5 140H198.5L196.4 160H33.6Z"></path>
              <g class="o-cool-lid">
                <path class="o-white" d="M20 118H210L205 84Q204 76 196 76H34Q26 76 25 84Z"></path>
                <path class="o-teal" d="M23 98H207L205.800 90H24.200Z"></path>
                <path class="o-line" d="M22 114H208"></path>
              </g>
              <rect class="o-white" x="100" y="108" width="30" height="16" rx="3"></rect>
              <path class="o-handle" d="M20 124Q10 150 24 172M210 124Q220 150 206 172"></path>
            </g>
          </svg>
          <i class="jb-sweat"></i>
        </span>
        <span class="jb-tag">{S.stack.label}</span>
      </button>

      <button type="button" class="jb-obj jb-ball" style="--w:96;--i:4" data-fx="0.875" data-y="912" data-pfx="0.9" data-prow="ball" aria-label={S.ball}>
        <span class="jb-art">
          <svg viewBox="-50 -50 100 106" aria-hidden="true" focusable="false"><ellipse class="o-shadow o-sh" style="--sk:0.3" cx="4" cy="46" rx="40" ry="7"></ellipse></svg>
          <svg class="jb-ball-art" viewBox="-50 -50 100 106" aria-hidden="true" focusable="false">
            <g clip-path="url(#ballClip)">
              {ballWedges.map((w) => <path class={w.c} d={w.d}></path>)}
              <circle class="o-white" cx="-8" cy="-12" r="8"></circle>
            </g>
          </svg>
        </span>
      </button>
    </nav>

    <div class="jb-top">
      <nav class="jb-lang" aria-label={S.nav.language}>
        <a href="/" lang="en" hreflang="en" aria-label="English" aria-current={lang === "en" ? "page" : undefined}>EN</a>
        <span aria-hidden="true">·</span>
        <a href="/pt-br/" lang="pt-BR" hreflang="pt-BR" aria-label="Português (Brasil)" aria-current={lang === "pt-br" ? "page" : undefined}>PT</a>
      </nav>
      <a class="jb-hello" href={`mailto:${PROFILE.email}`}>{S.contact.hello}</a>
    </div>

    <!-- Work: the notebook that was lying on the towel. One role per spread, newest first. Without JS it is a plain list of every role. -->
    <section class="jb-book" id="jb-book" role="dialog" aria-modal="false" aria-labelledby="jb-h-work" tabindex="-1">
      <div class="jb-grab jb-bk-grab" aria-hidden="true"><i></i></div>
      <header class="jb-bk-head">
        <p class="jb-eyebrow">{PROFILE.role} · {firstYear}–{S.now}</p>
        <h2 id="jb-h-work">{S.work.label} <span>— {S.work.sub}</span></h2>
      </header>
      <div class="jb-tilt">
      <div class="jb-marks" role="tablist" aria-label={S.work.roles}>
        {
          roles.map((r) => (
            <button type="button" role="tab" class="jb-mark" id={`jb-mark-${r.i}`} style={`--c:${MARKS[r.i % MARKS.length]};--n:${r.i}`} aria-controls={`jb-sp-${r.i}`} aria-selected={r.i === 0 ? "true" : "false"} tabindex={r.i === 0 ? 0 : -1}>
              <span class="jb-mark-c">{r.short}</span>
              <span class="jb-mark-y">{r.years}</span>
            </button>
          ))
        }
      </div>
      <div class="jb-board">
        <div class="jb-leaves">
          {
            roles.map((r) => (
              <article class="jb-spread" role="tabpanel" id={`jb-sp-${r.i}`} aria-labelledby={`jb-mark-${r.i}`} data-i={r.i}>
                <div class="jb-pg jb-pg-l">
                  <p class="jb-folio"><span class="jb-no">{S.work.folio}</span><span class="jb-numeral">{r.numeral}</span></p>
                  <h3>{r.role}</h3>
                  <p class="jb-co"><a href={r.link} target="_blank" rel="noopener">{r.company}<i aria-hidden="true"> ↗</i></a></p>
                  <p class="jb-period">{r.years}</p>
                  <svg class="jb-ruler" viewBox={`0 0 ${(nowYear - firstYear) * 20 + 20} 44`} aria-hidden="true" focusable="false">
                    <path class="jb-ruler-mark" pathLength="1" d={`M${(r.start - firstYear) * 20 + 10} 17H${(r.end - firstYear) * 20 + 10}`}></path>
                    <path class="jb-ruler-line" d={`M10 17H${(nowYear - firstYear) * 20 + 10}`}></path>
                    {Array.from({ length: nowYear - firstYear + 1 }, (_, y) => <path class="jb-ruler-line jb-tick" style={`--i:${y}`} d={`M${y * 20 + 10} ${y % 2 ? 13 : 9}V17`}></path>)}
                    <text x="10" y="38" text-anchor="start">{firstYear}</text>
                    <text x={(nowYear - firstYear) * 20 + 10} y="38" text-anchor="end">{S.now}</text>
                  </svg>
                  <p class="jb-aside" aria-hidden="true"><span>{asides[r.i]}</span></p>
                  <p class="jb-scribble">
                    <svg viewBox="0 0 64 20" aria-hidden="true" focusable="false"><path pathLength="1" d="M2 12q8 -12 15 0t15 0t15 0t15 0"></path></svg>
                    {r.note}
                  </p>
                  <svg class="jb-doodle" viewBox="0 0 60 50" aria-hidden="true" focusable="false"><path pathLength="1" d={DOODLES[r.i % DOODLES.length]}></path></svg>
                </div>
                <div class="jb-pg jb-pg-r" tabindex="0" aria-label={S.work.pageAria(r.company)}>
                  <p class="jb-built">{S.work.builtAt(r.short)}</p>
                  <ul class="jb-notes">{r.description.map((d) => <li><Fragment set:html={d} /></li>)}</ul>
                </div>
              </article>
            ))
          }
          <div class="jb-cast" aria-hidden="true"></div>
          <div class="jb-leaf" aria-hidden="true">
            <div class="jb-leaf-face jb-leaf-f"><div class="jb-leaf-in"></div><div class="jb-leaf-sh"></div></div>
            <div class="jb-leaf-face jb-leaf-b"><div class="jb-leaf-in"></div><div class="jb-leaf-sh"></div></div>
          </div>
          <div class="jb-lid" aria-hidden="true">
            <div class="jb-lid-f">
              <i class="jb-lid-label"></i>
              <i class="jb-lid-sun"></i>
            </div>
            <div class="jb-lid-b"></div>
          </div>
          <button type="button" class="jb-turn jb-prev" aria-label={S.work.prev}><span aria-hidden="true">‹</span></button>
          <button type="button" class="jb-turn jb-next" aria-label={S.work.next}><span aria-hidden="true">›</span></button>
          <p class="jb-pageno" aria-live="polite"><b id="jb-pg-now">1</b> / {roles.length}</p>
        </div>
      </div>
      <button type="button" class="jb-close jb-bk-close" aria-label={S.work.close}><span aria-hidden="true">✕</span></button>
      </div>
    </section>

    <div class="jb-panel" id="jb-panel" role="dialog" aria-modal="false" aria-labelledby="jb-h-about" tabindex="-1">
      <i class="jb-ptab" aria-hidden="true"></i>
      <div class="jb-paper">
        <div class="jb-grab" aria-hidden="true"><i></i></div>
        <button type="button" class="jb-close" aria-label={S.closePanel}><span aria-hidden="true">✕</span></button>
        <div class="jb-scroll">
          <section class="jb-sec jb-s-about" id="about" data-sec="about" style={`--mark:${MARKS[1]}`} aria-labelledby="jb-h-about">
            <p class="jb-eyebrow">{PROFILE.role}</p>
            <h2 id="jb-h-about">{S.about.label}</h2>
            <blockquote class="jb-quote">“{PROFILE.tagline}”</blockquote>
            <p class="jb-body">{PROFILE.summary}</p>
            <ul class="jb-facts">
              <li><b>{firstYear}</b><span>{S.about.since}</span></li>
              <li><b>{roles.length}</b><span>{S.about.roles}</span></li>
              <li><b>{toolCount}</b><span>{S.about.tools}</span></li>
              <li class="jb-fact-now"><b>{roles[0].short}</b><span>{S.about.currently} · {roles[0].company.match(/\((.*?)\)/)?.[1] ?? roles[0].years}</span></li>
            </ul>
            <p class="jb-where">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-6.500-6-6.500-11a6.500 6.500 0 0 1 13 0c0 5-6.500 11-6.500 11Z"></path><circle cx="12" cy="10" r="2.400"></circle></svg>
              <span>{S.about.basedIn} <a href={PROFILE.cityLink} target="_blank" rel="noopener">{shortCity}, {S.about.country}<i aria-hidden="true"> ↗</i></a> · UTC−3</span>
            </p>
            <p class="jb-colophon"><a href={colophonHref}>{S.about.colophon}</a></p>
          </section>

          <section class="jb-sec jb-s-contact" id="contact" data-sec="contact" style={`--mark:${MARKS[0]}`} aria-labelledby="jb-h-contact">
            <div class="jb-stamps" aria-hidden="true">
              <svg class="jb-postmark" viewBox="0 0 120 120" focusable="false">
                <defs><path id="jb-pm-arc" d="M60 60m-42 0a42 42 0 1 1 84 0a42 42 0 1 1 -84 0"></path></defs>
                <circle cx="60" cy="60" r="54"></circle>
                <circle cx="60" cy="60" r="31"></circle>
                <text><textPath href="#jb-pm-arc" startOffset="2%">{S.contact.postmark(PROFILE.role, firstYear).toUpperCase()}</textPath></text>
                <path d="M38 54q6 -7 11 0t11 0t11 0t11 0M38 66q6 -7 11 0t11 0t11 0t11 0"></path>
              </svg>
              <svg class="jb-stamp" viewBox="0 0 80 96" focusable="false">
                <rect x="1" y="1" width="78" height="94" fill="#FBF7EC" stroke="#23201A" stroke-width="1.5" stroke-dasharray="1 5" stroke-linecap="round"></rect>
                <rect x="8" y="8" width="64" height="64" fill="#6cc3ee"></rect>
                <circle cx="54" cy="24" r="9" fill="#ffc93c"></circle>
                <rect x="8" y="34" width="64" height="16" fill="#0fa3b8"></rect>
                <path d="M8 46q30 -7 64 0v6H8Z" fill="#6fe0cd"></path>
                <path d="M8 52q30 -6 64 0V72H8Z" fill="#f8d49a"></path>
                <path d="M30 72L36 40M36 40q-10 -6 -16 0M36 40q-2 -10 -12 -10M36 40q6 -10 16 -6M36 40q10 -2 14 6" stroke="#2e7d56" stroke-width="2.4" fill="none" stroke-linecap="round"></path>
                <text x="40" y="87" text-anchor="middle" font-size="9" font-family="Geist Mono, monospace" fill="#23201A" letter-spacing="1">{S.contact.stamp}</text>
              </svg>
            </div>
            <p class="jb-eyebrow">{S.contact.eyebrow}</p>
            <h2 id="jb-h-contact">{S.contact.heading}</h2>
            <p class="jb-letter">{S.contact.letter}</p>
            <ul class="jb-address">
              <li>
                <span>{S.contact.email}</span>
                <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
                <button type="button" class="jb-copy" data-copy={PROFILE.email} aria-label={S.contact.copyAria}><span class="jb-copy-t" aria-live="polite">{S.client.copy}</span></button>
              </li>
              <li><span>{S.contact.cv}</span><a href={PROFILE.cvLink} target="_blank" rel="noopener">{PROFILE.cvLink.replace("https://", "")}<i aria-hidden="true"> ↗</i></a></li>
              {PROFILE.socials.map((s) => <li><span>{s.label}</span><a href={s.href} target="_blank" rel="noopener">{s.handle}<i aria-hidden="true"> ↗</i></a></li>)}
            </ul>
            <p class="jb-sign" aria-hidden="true">{S.contact.sign}</p>
          </section>

          <section class="jb-sec jb-s-stack" id="stack" data-sec="stack" style={`--mark:${MARKS[2]}`} aria-labelledby="jb-h-stack">
            <p class="jb-eyebrow">{S.stack.eyebrow}</p>
            <h2 id="jb-h-stack">{S.stack.label}</h2>
            <p class="jb-stack-lede">{S.stack.lede}</p>
            <dl class="jb-bag">
              {
                STACK.map((g, i) => (
                  <div class={g.featured ? "jb-bag-feat" : undefined} style={`--tab:${TABS[i % TABS.length]}`}>
                    <dt>
                      {g.group}
                      {g.note && <small>{g.note}</small>}
                    </dt>
                    <dd>
                      {g.capabilities && (
                        <ul class="jb-caps">
                          {g.capabilities.map((c) => <li>{c}</li>)}
                        </ul>
                      )}
                      {g.toolsets ? (
                        <dl class="jb-sets">
                          {g.toolsets.map((t) => (
                            <div>
                              <dt>{t.label}</dt>
                              <dd>{t.items.join(" · ")}</dd>
                            </div>
                          ))}
                        </dl>
                      ) : (
                        <ul>
                          {g.items.map((it) => <li>{it}</li>)}
                        </ul>
                      )}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </section>
        </div>
      </div>
    </div>

    <!-- while something is open the four things stay one click away -->
    <nav class="jb-dock" aria-label={S.nav.dock}>
      {[["work", S.work.label], ["about", S.about.label], ["stack", S.stack.label], ["contact", S.contact.label]].map(([id, label]) => <button type="button" data-go={id}>{label}</button>)}
    </nav>

    <svg class="jb-fg jb-sway-a jb-veiled" viewBox="0 0 1600 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false"><use href="#L-fgA"></use></svg>
    <svg class="jb-fg jb-fg-late jb-sway-b jb-veiled" viewBox="0 0 1600 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false"><use href="#L-fgB"></use></svg>
  </main>

<style is:global>
  :root, .jb-palette-probe {
    --ink: #23201a;
    --cream: #fbf7ec;
    --green: #12695c;
    --coral: #e8694a;
    --hair: rgb(35 32 26 / 0.16);
    --serif: "Fraunces", "Iowan Old Style", Georgia, serif;
    --sans: "Geist", system-ui, sans-serif;
    --mono: "Geist Mono", ui-monospace, monospace;
    --hand: "Caveat", "Bradley Hand", cursive;
    --spring: cubic-bezier(0.3, 1.5, 0.5, 1);

    /* gouache box — "day" */
    --sky-0: #2f9fe0; --sky-1: #6cc3ee; --sky-2: #b5e6ee; --sky-3: #ffeec9;
    --cloud: #fffaf0; --cloud-shade: #c5d8ea; --cloud-hi: #ffffff;
    --sun: #ffe27a; --halo: #fff3c4; --sun-y: 96px; --sun-o: 1; --moon-o: 0; --stars: 0; --lights: 0;
    --far-1: #7fb4c4; --far-2: #a9d0dc;
    --sea-0: #0b7fa6; --sea-1: #0e9db6; --sea-2: #1fbfc0; --sea-3: #5fdccb; --sea-4: #a9eeda; --foam: #fffdf4; --glitter: #fff6cf;
    --veil: #ffffff;
    --hill: #4fa45e; --hill-dk: #2e7d56; --hill-lt: #8fce62;
    --sand: #f8d49a; --sand-lt: #ffe8bd; --sand-dk: #ecba78; --wet: #dcab70; --dune: #f3c98a;
    --g1: #3f9657; --g2: #7dbd55; --g3: #24694a; --straw: #e0b958;
    --on-sky: #1d1a14; --id-back: rgb(255 250 235 / 0.42); --id-plate: rgb(255 251 240 / 0.62);
    /* sprite paint: the script multiplies these by the current veil so loose objects match the veiled layers */
    --v-cream: #fdf3da; --v-white: #fffdf4; --v-coral: #f0583a; --v-teal: #0fa3b8; --v-gold: #ffc93c; --v-green: #2fa36b; --v-navy: #1d4e89;
    --v-amber: #c9772b; --v-glass: #b6ebe0; --v-cork: #b98654; --v-pages: #efe3c4; --v-fold: #e9d7ae; --v-pole: #fff6e0; --v-under: #b63a27;
    --v-skin-a: #e9ae7e; --v-skin-b: #e3ab80; --v-hair-dark: #382e29; --v-hair-light: #967047; --v-hair-highlight: #c79b62; --v-orange: #ff8a2a; --v-port-royale: #502b33; --v-pink: #ed79ad; --v-pink-dark: #ca518d; --v-racket-gray: #a6adb4;
    /* fixed land paint (the veil filter tints it; lite bakes the veil into these instead — see LAND in the script) */
    --p-wall: #fbf3df; --p-roof-a: #d95a35; --p-roof-b: #b2452a; --p-speck-dk: #d29f5e; --p-speck-lt: #fff3d6; --p-starfish: #f0583a; --p-shell: #fff6e4; --p-trunk: #96704a; --p-ring: #6c5138; --p-seed: #c99c45;
    --v-dark: #4a3a2a; --v-char: #3a3a3a; --v-brown: #6c5138; --v-shade: #9a7440; --v-crab: #e0502f; --v-hill: #4fa45e; --v-hill-dk: #2e7d56; --v-hill-lt: #8fce62;
  }
  [data-tod="dawn"] {
    --sky-0: #4a5f9c; --sky-1: #a394c2; --sky-2: #f4b4ae; --sky-3: #ffc88c;
    --cloud: #f6cfcc; --cloud-shade: #a487ae; --cloud-hi: #ffe2cf;
    --sun: #ffd9a0; --halo: #ffc09a; --stars: 0.22; --lights: 0.6;
    --far-1: #7a7dab; --far-2: #a498bb;
    --sea-0: #2c5688; --sea-1: #4a7ba3; --sea-2: #8aa6bb; --sea-3: #e0b3b2; --sea-4: #f7cfbd; --foam: #fde6da; --glitter: #ffd5b8;
    --veil: #d4aebb;
    --on-sky: #fff6e4; --id-back: rgb(30 30 80 / 0.34); --id-plate: rgb(8 12 34 / 0.5);
  }
  [data-tod="morning"] {
    --sky-0: #6cb6e2; --sky-1: #b4dcea; --sky-2: #fbe2c8; --sky-3: #ffc3a0;
    --cloud: #fff4e6; --cloud-shade: #ecc3be; --cloud-hi: #fffaf2;
    --sun: #ffd28a; --halo: #ffe2bd; --sun-y: 176px;
    --far-1: #a4b8cb; --far-2: #d2d0d8;
    --sea-0: #1b88a6; --sea-1: #33aab6; --sea-2: #66cfc3; --sea-3: #9fe6d2; --sea-4: #d6f3df; --glitter: #ffe9c9;
    --veil: #fff0de;
  }
  [data-tod="golden"] {
    --sky-0: #6d9fc8; --sky-1: #eac795; --sky-2: #fbb166; --sky-3: #fb8f4c;
    --cloud: #ffe6bd; --cloud-shade: #e08a68; --cloud-hi: #fff4da;
    --sun: #ffe38c; --halo: #ffd690; --sun-y: 182px;
    --far-1: #9a8aa4; --far-2: #cfa596;
    --sea-0: #1d6f8c; --sea-1: #3a979c; --sea-2: #7fc4a6; --sea-3: #f2cf8a; --sea-4: #fcdfa8; --foam: #fff3df; --glitter: #ffdf9a;
    --veil: #ffd9a6;
  }
  [data-tod="dusk"] {
    --sky-0: #36447c; --sky-1: #8a5a92; --sky-2: #ea7a6c; --sky-3: #fbaa5e;
    --cloud: #d88c90; --cloud-shade: #67507f; --cloud-hi: #f9b596;
    --sun: #ffb36e; --halo: #ff9f7a; --sun-y: 226px; --stars: 0.35; --lights: 0.9;
    --far-1: #4f5688; --far-2: #6b6c9c;
    --sea-0: #273a6c; --sea-1: #3d5788; --sea-2: #7c6c9c; --sea-3: #e6957f; --sea-4: #f6b494; --foam: #f8dbd0; --glitter: #ffb98c;
    --veil: #ac8ab4;
    --on-sky: #fff6e4; --id-back: rgb(24 20 56 / 0.38); --id-plate: rgb(8 12 34 / 0.5);
  }
  [data-tod="night"] {
    --sky-0: #0b1230; --sky-1: #131f49; --sky-2: #1f3060; --sky-3: #33507e;
    --cloud: #2c3b64; --cloud-shade: #1a2547; --cloud-hi: #45598b;
    --halo: #cfd8f2; --sun-y: 92px; --sun-o: 0; --moon-o: 1; --stars: 1; --lights: 1;
    --far-1: #172347; --far-2: #1f2d55;
    --sea-0: #0e2146; --sea-1: #15305a; --sea-2: #1d456c; --sea-3: #2c6a88; --sea-4: #4a8da4; --foam: #a6bdd0; --glitter: #dfe6f5;
    --veil: #4c5f96;
    --on-sky: #fff6e4; --id-back: rgb(6 10 30 / 0.4); --id-plate: rgb(8 12 34 / 0.5);
  }

  html { background: #f3cf95; }
  body { font-family: var(--sans); color: var(--ink); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  html.js, html.js body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  .jb-paintbox { position: absolute; }
  .jb-world a { color: inherit; }
  .jb-world :focus-visible { outline: 2.5px solid var(--green); outline-offset: 2px; border-radius: 4px; }
  .jb-world .jb-panel:focus-visible, .jb-world .jb-book:focus-visible { outline: none; }

  /* ── paint classes ── */
  .st-sky0 { stop-color: var(--sky-0); } .st-sky1 { stop-color: var(--sky-1); }
  .st-sky2 { stop-color: var(--sky-2); } .st-sky3 { stop-color: var(--sky-3); }
  .st-halo { stop-color: var(--halo); }
  .veil-flood { flood-color: var(--veil); }
  .sky-strokes path { fill: none; stroke: var(--cloud-hi); stroke-linecap: round; }
  .stars { fill: #fff; opacity: calc(var(--stars) * (0.25 + 0.75 * var(--clear, 1))); }
  .sun { fill: var(--sun); }
  .moon-dark { fill: #b9c4e6; opacity: 0.2; } .moon-lit { fill: #fdf8e3; } .moon-mare { fill: #e3dcc0; opacity: 0.75; }
  .kite-line { fill: none; stroke: var(--v-dark); stroke-width: 0.8; opacity: 0.7; } .kite-wing { fill: var(--v-coral); } .kite-body { fill: var(--v-dark); }
  .kite-board { fill: none; stroke: var(--v-gold); stroke-width: 2.6; stroke-linecap: round; } .kite-spray { fill: none; stroke: var(--foam); stroke-width: 1.6; stroke-linecap: round; }
  .wetsand { fill: #8f6f4a; } .puddles { fill: var(--sky-2); opacity: 0.5; } .puddle-hi path { fill: none; stroke: #fff; stroke-width: 2.5; stroke-linecap: round; opacity: 0.55; }
  .c-shade { fill: var(--cloud-shade); } .c-body { fill: var(--cloud); } .c-hi { fill: var(--cloud-hi); opacity: 0.85; }
  .far1 { fill: var(--far-1); } .far2 { fill: var(--far-2); }
  .sea0 { fill: var(--sea-0); } .sea1 { fill: var(--sea-1); } .sea2 { fill: var(--sea-2); } .sea3 { fill: var(--sea-3); } .sea4 { fill: var(--sea-4); }
  .foam { fill: var(--foam); }
  .tones path { fill: none; stroke-linecap: round; } .t-dk { stroke: var(--sea-0); } .t-lt { stroke: var(--sea-4); }
  .glitter path { fill: none; stroke: var(--glitter); stroke-linecap: round; }
  .waves path { fill: none; stroke: var(--foam); stroke-linecap: round; }
  .waves .lace { stroke-width: 4; opacity: 0.85; }
  .refl { fill: var(--hill-dk); opacity: 0.3; }
  .h-md { fill: var(--hill); } .h-dk { fill: var(--hill-dk); } .h-lt { fill: var(--hill-lt); }
  .wall { fill: var(--p-wall); } .roof-a { fill: var(--p-roof-a); } .roof-b { fill: var(--p-roof-b); }
  .sail path { fill: var(--v-cream); } .sail .hullf { fill: var(--v-char); }
  .hull { fill: var(--v-cream); } .hull-stripe { fill: var(--v-coral); } .cabin { fill: var(--v-teal); } .cabin-win { fill: var(--v-cream); }
  .mast { fill: none; stroke: var(--v-dark); stroke-width: 2.5; }
  .pennant { fill: var(--v-gold); }
  .lamp { fill: #ffd977; opacity: var(--lights); }
  .crown .h-md { fill: var(--v-hill); } .crown .h-dk { fill: var(--v-hill-dk); } .crown .h-lt { fill: var(--v-hill-lt); } .crown .coco { fill: var(--v-brown); }
  .xstars { fill: #fff; }
  .swell path { fill: none; stroke: var(--sea-4); stroke-linecap: round; opacity: 0.4; }
  .wash-film { fill: var(--sea-4); opacity: 0.6; } .wash-foam { fill: var(--foam); }
  .wash-lace { fill: none; stroke: var(--foam); stroke-width: 3.4; stroke-linecap: round; opacity: 0.8; }
  .sheen { fill: #8a6230; opacity: 0.5; }
  .boat-refl path { fill: none; stroke: var(--sea-0); stroke-width: 4; stroke-linecap: round; opacity: 0.45; }
  .wet { fill: var(--wet); } .sand { fill: var(--sand); } .dune { fill: var(--dune); }
  .sand-strokes path { fill: none; stroke-linecap: round; opacity: 0.5; }
  .sand-strokes .s-lt { stroke: var(--sand-lt); } .sand-strokes .s-dk { stroke: var(--sand-dk); }
  circle.s-dk { fill: var(--p-speck-dk); opacity: 0.7; } circle.s-lt { fill: var(--p-speck-lt); opacity: 0.9; }
  .starfish { fill: var(--p-starfish); } .shells { fill: var(--p-shell); stroke: var(--p-speck-dk); stroke-width: 1.2; }
  .trunk { fill: var(--p-trunk); } .rings path { fill: none; stroke: var(--p-ring); stroke-width: 1.8; opacity: 0.6; }
  .blades path { fill: none; stroke-linecap: round; }
  .blades .g1 { stroke: var(--g1); } .blades .g2 { stroke: var(--g2); } .blades .g3 { stroke: var(--g3); } .blades .straw { stroke: var(--straw); }
  .seedhead { fill: var(--p-seed); }
  /* object paint */
  .o-cream { fill: var(--v-cream); } .o-white { fill: var(--v-white); } .o-coral { fill: var(--v-coral); } .o-teal { fill: var(--v-teal); } .o-gold { fill: var(--v-gold); }
  .o-green { fill: var(--v-green); } .o-navy { fill: var(--v-navy); } .o-amber { fill: var(--v-amber); } .o-dark { fill: var(--v-dark); } .o-cork { fill: var(--v-cork); }
  .o-pages { fill: var(--v-pages); } .o-fold { fill: var(--v-fold); } .o-under { fill: var(--v-under); }
  .o-glass { fill: var(--v-glass); opacity: 0.88; }
  .o-glint { fill: none; stroke: var(--v-white); stroke-width: 4; stroke-linecap: round; opacity: 0.9; }
  .o-shadow { fill: var(--v-shade); opacity: 0.34; } .o-shadow.wetsh { opacity: 0.28; }
  /* shadows follow the sun: pushed away from it, longer when it is low, gone under a grey sky */
  .o-sh { transform-box: fill-box; transform-origin: 50% 50%; transform: translateX(calc(var(--sh-x, 0.5) * var(--sk, 1) * 60px)) scaleX(var(--sh-l, 1)); opacity: var(--sh-o, 0.34); transition: transform 1.2s ease, opacity 1.2s ease; }
  [data-umb="shut"] .o-sh-umb { transform: translateX(calc(var(--sh-x, 0.5) * 24px)) scaleX(0.3); }
  .o-strap { fill: none; stroke: var(--v-navy); stroke-width: 4; stroke-linecap: round; }
  .o-cover-line { fill: none; stroke: var(--v-shade); stroke-width: 2; stroke-linecap: round; opacity: 0.45; }
  .o-lan-wire { fill: none; stroke: var(--v-dark); stroke-width: 2.6; stroke-linecap: round; } .o-lan-lit { fill: #ffd977; opacity: var(--lights); }
  .o-pole { fill: none; stroke: var(--v-pole); stroke-width: 7; stroke-linecap: round; }
  .o-line { fill: none; stroke: var(--v-dark); stroke-width: 2.4; stroke-linecap: round; opacity: 0.55; } .o-line.lt { stroke: var(--v-cream); opacity: 0.8; } .o-line.dk { stroke: var(--v-amber); stroke-width: 2; opacity: 0.8; }
  .o-fringe { fill: none; stroke: var(--v-cream); stroke-width: 3; stroke-linecap: round; }
  .o-handle { fill: none; stroke: var(--v-white); stroke-width: 7; stroke-linecap: round; }
  .o-shades { fill: var(--v-char); stroke: var(--v-char); stroke-width: 3; }

  /* ── the scene ── */
  .jb-scene { position: absolute; inset: 0 0 auto 0; height: 60svh; overflow: hidden; z-index: 0; background: var(--sky-1); }
  html.js .jb-scene { position: fixed; height: 100svh; }
  .jb-draft { will-change: opacity; position: fixed; inset: 0; z-index: 3; overflow: hidden; pointer-events: none; background: #f5f0e5; }
  .jb-draft-paint { position: absolute; inset: 0; filter: grayscale(1); }
  .jb-draft [filter], .jb-draft .jb-veiled { filter: none !important; }
  .jb-draft .jb-scene { background: #f5f0e5; }
  .jb-deck-drawing { display: none; }
  .jb-draft .jb-deck { background: none; -webkit-mask-image: none !important; mask-image: none !important; }
  .jb-draft .jb-deck-drawing { display: block; width: 100%; height: 100%; }
  .jb-draft .jb-grain, .jb-draft .jb-tag { visibility: hidden; }
  .jb-draft *, .jb-draft *::before, .jb-draft *::after { animation-play-state: paused !important; transition: none !important; pointer-events: none !important; }
  html.js .jb-draft .jb-scene { position: absolute; }
  .jb-layer { position: absolute; inset: -24px; width: calc(100% + 48px); height: calc(100% + 48px); display: block; }
  html.js .jb-nojs { display: none; }
  .jb-xstars { opacity: calc(var(--stars) * var(--clear, 0.5)); }
  .jb-sheen-l, .jb-wash-l { opacity: 0; }
  .jb-glit-a, .jb-glit-b, .jb-swell, .jb-shimmer-a, .jb-shimmer-b, .jb-wash-l, .jb-sheen-l { transform-origin: 50% var(--hz, 25%); }
  .jb-wash-a { --amp: calc(0.094 * var(--amp-k, 1)); } .jb-wash-b { --amp: calc(0.05 * var(--amp-k, 1)); } .jb-wash-c { --amp: calc(0.075 * var(--amp-k, 1)); display: none; }
  [data-storm] .jb-wash-c { display: block; }

  /* stages: a 1600×1000 board laid exactly over the painting; sprites are placed in painting units */
  .jb-stage { display: none; }
  html.js .jb-stage { display: block; position: absolute; left: 0; top: 0; width: 1600px; height: 1000px; transform-origin: 0 0; transform: translate(var(--ox, 0px), var(--oy, 0px)) scale(var(--fs, 1)); pointer-events: none; }
  .jb-stage > * { position: absolute; }
  .jb-spr { display: block; overflow: hidden; }
  .jb-cloud { opacity: 0; transition: opacity 2.6s ease; }
  .jb-st-sky { opacity: calc(var(--stars) * var(--clear, 1)); }
  /* sun, moon, and the glow they leave on the horizon: placed by the script along the day's arc */
  .jb-sun, .jb-moon { left: 0; top: 0; width: 0; height: 0; }
  .jb-sun > *, .jb-moon > * { position: absolute; left: 0; top: 0; translate: -50% -50%; }
  .jb-sun-disc { width: 100px; height: 100px; } .jb-moon svg { width: 76px; height: 76px; }
  .jb-halo { width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--halo) 78%, transparent), transparent); }
  .jb-halo-moon { width: 190px; height: 190px; background: radial-gradient(closest-side, rgb(207 216 242 / 0.4), transparent); }
  .jb-rays { width: 620px; height: 620px; border-radius: 50%; opacity: var(--rays, 0);
    background: repeating-conic-gradient(from 0deg, rgb(255 244 190 / 0) 0deg 9deg, rgb(255 244 190 / 0.34) 13deg 17deg, rgb(255 244 190 / 0) 21deg 30deg);
    -webkit-mask-image: radial-gradient(closest-side, #000 18%, transparent 92%); mask-image: radial-gradient(closest-side, #000 18%, transparent 92%); }
  .jb-glow { left: 0; top: 0; width: 1300px; height: 440px; margin: -220px 0 0 -650px; border-radius: 50%; opacity: var(--glow, 0);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--sun) 80%, transparent), color-mix(in srgb, var(--halo) 40%, transparent) 45%, transparent); }
  .jb-shoot { width: 110px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #fff, transparent); rotate: -24deg; opacity: 0; }
  /* the overcast deck: three lumpy bands (CSS masks, so the palette paints them) rolled along by the wind */
  .jb-deck { left: -800px; width: 3200px; top: -70px; opacity: var(--deck, 0); transition: opacity 0.4s linear; -webkit-mask-size: 800px 100%; mask-size: 800px 100%; -webkit-mask-repeat: repeat-x; mask-repeat: repeat-x; }
  .jb-deck-back { height: 262px; background: linear-gradient(var(--cloud-shade), color-mix(in srgb, var(--cloud-shade) 72%, var(--sky-0))); }
  .jb-deck-front { height: 205px; background: linear-gradient(color-mix(in srgb, var(--cloud) 40%, var(--cloud-shade)), color-mix(in srgb, var(--cloud) 72%, var(--cloud-shade))); }
  .jb-deck-hi { height: 140px; top: -40px; background: color-mix(in srgb, var(--cloud-hi) 70%, var(--cloud-shade)); opacity: calc(var(--deck, 0) * 0.55); }
  .jb-flash { position: absolute; inset: 0; opacity: 0; pointer-events: none; background: linear-gradient(rgb(226 234 255 / 0.95), rgb(226 234 255 / 0.5) 34%, rgb(226 234 255 / 0.16) 70%); }
  .jb-bolt { left: 0; top: 104px; width: 62px; height: 140px; opacity: 0; overflow: visible; }
  .jb-bolt path { fill: none; stroke: #f6f8ff; stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .jb-sparks { left: 0; top: 0; width: 0; height: 0; opacity: var(--glit, 1); }
  .jb-spark { position: absolute; margin: -4px 0 0 -4px; background: #fff; clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); opacity: 0.85; }
  .jb-glit-a use, .jb-glit-b use { transform-origin: 870px 235px; transform: translateX(var(--lum-dx, 0px)) scaleX(var(--glit-w, 1)); opacity: var(--glit, 1); }
  .jb-cap { display: none; height: 3px; border-radius: 2px; background: var(--foam); opacity: 0; }
  [data-caps] .jb-cap { display: block; opacity: 0.6; }
  [data-storm] .jb-cap { height: 4.5px; scale: 1.7 1; }
  .jb-sail-go, .jb-kite-go { transition: opacity 3s ease; }
  .jb-sail-go > svg { width: 100%; height: 100%; }
  [data-storm] .jb-sail-go, [data-noboats] .jb-sail-go { opacity: 0; }
  .jb-kite-go { width: 0; height: 0; opacity: 0; }
  [data-kite] .jb-kite-go { opacity: 1; }
  .jb-kite { position: absolute; left: -45px; top: -59px; width: 67px; height: 67px; overflow: visible; transform-origin: 66% 88%; }
  .jb-boat-wrap { transition: translate 9s cubic-bezier(0.3, 0, 0.3, 1), opacity 3s ease 1s; }
  [data-storm] .jb-boat-wrap { translate: -760px 0; opacity: 0; transition: translate 9s cubic-bezier(0.6, 0, 0.9, 0.6), opacity 3s ease 5s; }
  .jb-boat-bob { position: absolute; inset: 0; } .jb-boat-bob > .jb-spr { width: 100%; height: 100%; }
  .jb-pennant { position: absolute; left: 65.6%; top: 11.9%; width: 11.7%; height: 11%; transform-origin: 0 50%; scale: var(--wdir, 1) 1; }
  [data-fog] .jb-boat-wrap, [data-fog] .jb-sail-go { filter: grayscale(1) brightness(0.62) opacity(0.75); }
  /* rain lands: dark blotches first, then the whole beach, then puddles; it dries much slower than it wets */
  .jb-wet-l { display: none; mix-blend-mode: multiply; }
  [data-wet] .jb-wet-l { display: block; }
  .jb-wet-blots { opacity: var(--wet-a, 0); } .jb-wet-full { opacity: var(--wet-b, 0); }
  .jb-mist { display: none; left: -900px; width: 3400px; opacity: calc(var(--fog, 0) * var(--mo, 1));
