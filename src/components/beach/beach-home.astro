  } catch {
    /* no cache */
  }
  async function poll() {
    const ctl = new AbortController();
    const timer = window.setTimeout(() => ctl.abort(), 4000);
    try {
      const res = await fetch(WX_URL, { signal: ctl.signal });
      if (!res.ok) return;
      const j = await res.json();
      const cur = j?.current;
      if (!cur || typeof cur.weather_code !== "number") return;
      const [sr0, ss0] = sunTimes();
      live = {
        at: Date.now(), temp: Number(cur.temperature_2m), feels: Number(cur.apparent_temperature), code: cur.weather_code, cover: Number(cur.cloud_cover) || 0,
        kmh: Number(cur.wind_speed_10m) || 0, gust: Number(cur.wind_gusts_10m) || Number(cur.wind_speed_10m) || 0, dir: Number(cur.wind_direction_10m) || 0,
        precip: Math.max(Number(cur.precipitation) || 0, Number(cur.rain) || 0, Number(cur.showers) || 0),
