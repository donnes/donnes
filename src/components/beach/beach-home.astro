  }
  [data-tod="night"] {
    --sky-0: #0b1230; --sky-1: #131f49; --sky-2: #1f3060; --sky-3: #33507e;
    --cloud: #2c3b64; --cloud-shade: #1a2547; --cloud-hi: #45598b;
    --halo: #cfd8f2; --sun-y: 92px; --sun-o: 0; --moon-o: 1; --stars: 1; --lights: 1;
    --far-1: #172347; --far-2: #1f2d55;
    --sea-0: #0e2146; --sea-1: #15305a; --sea-2: #1d456c; --sea-3: #2c6a88; --sea-4: #4a8da4; --foam: #a6bdd0; --glitter: #dfe6f5;
    --veil: #4c5f96;
