  /* ── identity: set straight on the sky; palette-aware ink + a soft haze, and a cream chip for the small print ── */
  .jb-world { position: relative; z-index: 1; padding: 60svh 16px 96px; }
  html.js .jb-world { position: fixed; inset: 0; padding: 0; }
  .jb-id { position: absolute; z-index: 4; top: 16px; left: 18px; right: 18px; color: var(--on-sky); transition: color 1.2s ease; }
  .jb-id::before { content: ""; position: absolute; z-index: -1; inset: -34px auto -30px -60px; width: min(760px, 120%); background: radial-gradient(closest-side, var(--id-back), transparent); pointer-events: none; }
