    --v-cream: #fdf3da; --v-white: #fffdf4; --v-coral: #f0583a; --v-teal: #0fa3b8; --v-gold: #ffc93c; --v-green: #2fa36b; --v-navy: #1d4e89;
    --v-amber: #c9772b; --v-glass: #b6ebe0; --v-cork: #b98654; --v-pages: #efe3c4; --v-fold: #e9d7ae; --v-pole: #fff6e0; --v-under: #b63a27;
    --v-skin-a: #e9ae7e; --v-skin-b: #e3ab80; --v-hair-dark: #382e29; --v-hair-light: #967047; --v-hair-highlight: #c79b62; --v-orange: #ff8a2a; --v-port-royale: #502b33; --v-pink: #ed79ad; --v-pink-dark: #ca518d; --v-racket-gray: #a6adb4;
