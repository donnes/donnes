    });
  }
  const VEILED = ["--v-cream", "--v-white", "--v-coral", "--v-teal", "--v-gold", "--v-green", "--v-navy", "--v-amber", "--v-glass", "--v-cork", "--v-pages", "--v-fold", "--v-pole", "--v-under", "--v-dark", "--v-char", "--v-brown", "--v-shade", "--v-crab", "--v-hill", "--v-hill-dk", "--v-hill-lt", "--v-skin-a", "--v-skin-b", "--v-hair-dark", "--v-hair-light", "--v-hair-highlight", "--v-orange", "--v-port-royale", "--v-pink", "--v-pink-dark", "--v-racket-gray"];
  const hex = (h: string) => {
    const v = h.trim().replace("#", "");
