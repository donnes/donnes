    const swing = opening
      ? [{ transform: "rotateY(0deg)", easing: "cubic-bezier(.5,0,.9,.6)" }, { transform: "rotateY(-90deg)", offset: 0.5, easing: "cubic-bezier(.1,.5,.3,1)" }, { transform: "rotateY(-180deg)" }]
