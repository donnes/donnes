      sail.x += dir * (3 + env.wind * 12) * dt;
      const pos = 966 + sail.x;
      if (pos > fit.left + fit.width + 80) sail.x = fit.left - 120 - 966;
      else if (pos < fit.left - 120) sail.x = fit.left + fit.width + 80 - 966;
