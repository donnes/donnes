  .jb-period { margin: 5px 0 0; font: 400 12.5px/1.4 var(--mono); color: #5a5447; }
  .jb-ruler { display: block; width: min(100%, 320px); margin: 16px 0 0 -8px; overflow: visible; }
  .jb-ruler-line { fill: none; stroke: var(--ink); stroke-width: 1.2; stroke-linecap: round; }
  .jb-ruler-mark { fill: none; stroke: #f2b632; stroke-width: 13; stroke-linecap: round; opacity: 0.9; }
