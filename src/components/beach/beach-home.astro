  .jb-id-nf h1 { max-width: calc(100% - 250px); } /* clear of the wider "come back" button */
  @media (max-width: 600px) { .jb-id.jb-id-nf { top: 92px; } .jb-id-nf h1 { max-width: none; } } /* phones: the heading drops under the button */
  .jb-role { margin: 7px 0 0; font: italic 460 clamp(19px, 2.1vw, 30px) / 1.12 var(--serif); font-variation-settings: "SOFT" 100; letter-spacing: -0.012em; }
  .jb-role span { padding: 0 3px 1px 1px; background: linear-gradient(transparent 84%, #ffc93c 84% 96%, transparent 96%); }
  .jb-now { display: none; align-items: center; gap: 9px; margin: 11px 0 0; font: 480 14.5px/1.3 var(--sans); letter-spacing: -0.005em; }
  .jb-now::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 50%; background: #35c07c; box-shadow: 0 0 0 3px rgb(53 192 124 / 0.3); }
  .jb-meta { display: inline-grid; gap: 2px; margin: 11px 0 0; padding: 6px 12px 7px 9px; max-width: 100%; border-radius: 10px; background: var(--id-plate); box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 14%, transparent); font: 400 11px/1.5 var(--mono); letter-spacing: -0.01em; transition: background-color 1.2s ease; }
