    }
    if (rateAcc > 1 || !busy) {
      rateAcc = 0;
      rates();
    }
    moving = busy;
  });

  /* ───────────── the sky: sun & moon, clouds, deck and shadows, lightning, a shooting star ───────────── */
  const sky = createSky(scene, {
    sun: q(".jb-sun"), moon: q(".jb-moon"), glow: q(".jb-glow"), sparks: q(".jb-sparks"), dimmer: q(".jb-dimmer"),
    clouds: qa<SVGSVGElement>(".jb-cloud"), decks: qa(".jb-deck"), shades: qa(".jb-cshade"),
    flash: q(".jb-flash"), bolt: q<SVGSVGElement>(".jb-bolt"), shoot: q(".jb-shoot"),
  });

  /* ───────────── render: env → palette + CSS variables + flags (called in steps, or once when snapping) ───────────── */
  const winEls = qa(".jb-win").map((el) => ({ el, th: rand(0.12, 0.92) }));
  function render() {
    const e = env;
    const base = palAt(e.cyc);
    const daylight = clamp(luma(base.c[1]) * 1.5, 0.12, 1);
    const tintC = [e.tr, e.tg, e.tb].map((v) => v * (0.22 + 0.78 * daylight));
    const dark = e.dark * (0.5 + 0.5 * daylight); // a night is dark enough already
    // weather look: pull saturation out, wash towards the sky's grey, darken
    const look = (c: number[], k = 1) => {
      const l = luma(c) * 255;
      return c.map((v, i) => {
        const d = v + (l - v) * e.desat * k;
        return (d + (tintC[i] - d) * e.tint * k) * (1 - dark * k);
      });
    };
    const cols = base.c.map((c, i) => look(c, i >= 4 && i <= 6 ? 1.12 : 1));
    COLS.forEach((k, i) => setVar(k, rgb(cols[i])));
    const theme = rgb(cols[0]).replace(/ /g, ", "); // the browser chrome continues the top of the sky
    if (themeMeta && themeMeta.content !== theme) themeMeta.content = theme;
    const veil = cols[18];
    setVar("--veil-b", ((0.2126 * veil[0] + 0.7152 * veil[1] + 0.0722 * veil[2]) / 255).toFixed(3));
    VEILED.forEach((k, i) => setVar(k, rgb(veiledBase[i].map((v, ch) => (v * veil[ch]) / 255))));
    paintLand(veil);
    const stars = base.n[0];
    const lights = clamp(Math.max(base.n[1], e.dark * 1.7 - 0.1), 0, 1);
    const night = lights > 0.75 && base.n[0] > 0.6;
    const sunny = e.sun * lum.sunUp;
    const low = 1 - clamp(lum.elev * 2.2, 0, 1);
    setVar("--stars", stars.toFixed(2));
    setVar("--lights", lights.toFixed(2));
    setVar("--clear", clamp(1 - e.cover * 0.75 - e.deck * 0.6, 0, 1).toFixed(2));
    setVar("--deck", e.deck.toFixed(3));
    setVar("--fog", clamp(e.fog + (e.cyc > 1.9 || e.cyc < 0.16 ? 0.4 * (1 - e.deck) * (1 - Math.abs((e.cyc > 1 ? e.cyc - 2 : e.cyc) - 0.03) / 0.13) : 0), 0, 1).toFixed(3));
    setVar("--mist-c", rgb(cols[3].map((v, i) => v + ((daylight > 0.5 ? 240 : cols[9][i] + 40) - v) * 0.6)));
    setVar("--r-first", e.rFirst.toFixed(3));
    setVar("--r-far", e.rFar.toFixed(3));
    setVar("--r-mid", e.rMid.toFixed(3));
    setVar("--r-near", e.rNear.toFixed(3));
    setVar("--rain-a", `${clamp(e.windX * (7 + 24 * e.wind), LITE ? -10 : -90, LITE ? 10 : 90).toFixed(1)}deg`); // lite: the one streak layer is cut close to the screen
    setVar("--spray", (e.spray * 0.8).toFixed(2));
    setVar("--wet-a", (clamp(e.wet * 2.6, 0, 1) * (0.26 - 0.14 * e.wet)).toFixed(3));
    setVar("--wet-b", (clamp((e.wet - 0.15) / 0.85, 0, 1) * (0.52 - 0.22 * e.dark - 0.16 * (1 - daylight))).toFixed(3));
    setVar("--tint", (e.fog * 0.2 + dark * 0.3).toFixed(3));
    setVar("--tint-c", rgb(tintC));
    setVar("--glit", (e.glit * (lum.sunUp ? 1 : 0.7) * clamp(lum.elev * 6, 0, 1)).toFixed(2));
    setVar("--rays", (sunny * clamp(lum.elev * 3, 0, 1) * (1 - e.cover * 0.5) * 0.9).toFixed(2));
    setVar("--glow", (low * clamp((lum.sunUp ? 1 : 0) + (e.cyc > 1 && e.cyc < 1.1 ? 1 - (e.cyc - 1) / 0.1 : e.cyc > 1.9 ? (e.cyc - 1.9) / 0.1 : 0), 0, 1) * (0.25 + 0.75 * e.sun) * 0.85).toFixed(2));
    setVar("--lum-dx", `${(lum.x - 870).toFixed(0)}px`);
    setVar("--glit-w", (1 + low * 0.9).toFixed(2)); // the light path widens as the sun (or moon) sinks
    setVar("--cshade", (clamp(1 - Math.abs(e.cover - 0.5) * 2.6, 0, 1) * (1 - e.deck) * sunny * clamp(lum.elev * 3 - 0.4, 0, 1) * 0.9).toFixed(2));
    // shadows fall away from the sun (or, faintly, the moon): long at the ends of the day, short at noon
    setVar("--sh-x", (-lum.side * (0.5 + low * 1.3)).toFixed(2));
    setVar("--sh-l", (1 + low * 0.55).toFixed(2));
    setVar("--sh-o", ((lum.sunUp ? 0.12 + 0.3 * e.shade : 0.1 + 0.12 * e.shade) * (1 - e.wet * 0.3)).toFixed(2));
    setVar("--sway", (0.5 + e.wind * 3).toFixed(2));
    setVar("--lean", `${(Math.sign(e.windX) * e.wind * 2.8).toFixed(2)}deg`);
    setVar("--wdir", e.windX < 0 ? "-1" : "1");
    setVar("--umb-lean", `${(Math.sign(e.windX) * (e.wind * 2.2 + e.storm * 3.5)).toFixed(2)}deg`);
    setVar("--umb-wob", `${(0.15 + e.wind * 1.5).toFixed(2)}deg`);
    setVar("--amp-k", e.amp.toFixed(2));
    // the name is set on the sky: pick the ink that reads on what is behind it right now
    const back = cols[1].map((v, i) => v + (cols[5][i] - v) * e.deck * 0.85);
    const darkSky = luma(back) < 0.46;
    setVar("--on-sky", darkSky ? "#fff6e4" : "#1d1a14");
    setVar("--id-back", darkSky ? "rgb(10 14 40 / 0.42)" : "rgb(255 250 235 / 0.5)");
    setVar("--id-plate", darkSky ? "rgb(8 12 34 / 0.52)" : "rgb(255 251 240 / 0.64)");
    // beach tennis: a rally whenever it is dry and light, overcast or foggy included; at night the rackets wait by the net, and rain or a storm leaves the court to the weather
    scene.court = e.rFirst > 0.04 || e.wet > 0.5 || e.storm > 0.1 ? "wet" : !NOT_FOUND && e.cyc > 0.085 && e.cyc < 0.965 ? "play" : "rest";
    const shut = e.cyc > 1.035 || e.cyc < 0.085;
    const hot = (scene.state?.temp ?? 0) >= 28 && !!lum.sunUp && e.rFirst < 0.05 && e.deck < 0.5;
    const cold = scene.state?.temp != null && scene.state.temp <= 15;
    root.dataset.umb = shut ? "shut" : "open";
    flag("night", night);
    flag("rain", e.rFirst > 0.02);
    flag("wet", e.wet > 0.004);
    flag("mist", e.fog > 0.01 || e.cyc > 1.88 || e.cyc < 0.17);
    flag("deck", e.deck > 0.004);
    flag("fog", e.fog > 0.6);
    flag("tuck", e.rMid > 0.18);
    flag("lid", e.rMid > 0.28);
    flag("drip", e.rMid > 0.22 && !shut);
    flag("windy", e.wind > 0.55 && e.wet < 0.25);
    flag("caps", e.wind > 0.5 || e.storm > 0.4);
    flag("storm", e.storm > 0.5);
    flag("kite", e.wind > 0.5 && e.storm < 0.2 && e.rMid < 0.35 && e.fog < 0.5 && !!lum.sunUp && lum.elev > 0.15);
    flag("noboats", !!scene.state && !PHASES[scene.state.phase].boats);
    flag("ff", night && e.rFirst < 0.05 && e.wind < 0.6);
    flag("hot", hot);
    flag("cold", !!cold);
    flag("noshades", !!cold || e.rFirst > 0.1 || e.deck > 0.6 || lights > 0.5);
    for (const w of winEls) w.el.classList.toggle("on", lights > w.th);
  }
  // animation speeds follow the wind and the sea state (looked up by keyframe name, never per-frame)
  const RATE_OF: Record<string, (e: Env) => number> = {
    "jb-sway": (e) => 0.7 + e.wind * 2, "jb-crown": (e) => 0.7 + e.wind * 2.2, "jb-flap": (e) => 0.4 + e.wind * 3.4, "jb-penn": (e) => 0.5 + e.wind * 2.5, "jb-umb": (e) => 0.8 + e.wind * 2,
    "jb-shimmer": (e) => e.sea, "jb-swell": (e) => e.sea, "jb-wash": (e) => e.sea, "jb-sheen": (e) => e.sea, "jb-sheen-soft": (e) => e.sea, "jb-ride": (e) => e.sea, "jb-pop": (e) => e.sea,
    "jb-rain-near": (e) => e.rSpd, "jb-rain-mid": (e) => e.rSpd, "jb-rain-far": (e) => e.rSpd, "jb-splash": (e) => 0.6 + e.rMid, "jb-ripple": (e) => 0.6 + e.rMid * 0.8,
    "jb-wisp": (e) => 0.6 + e.wind, "jb-mist": (e) => 0.6 + e.wind * 2, "jb-net": (e) => 0.5 + e.wind * 2.2 + e.storm,
  };
  function rates() {
    if (calm.matches || !document.getAnimations) return;
    for (const a of document.getAnimations()) {
      const fn = RATE_OF[(a as CSSAnimation).animationName];
      if (fn) a.playbackRate = fn(env);
    }
  }
  // the quiet line under the location: glyph · local time · phase of the day · temperature, sky and wind
  function chip(s: SceneState) {
    const phase = document.getElementById("jb-phase");
    const wx = document.getElementById("jb-wx");
    const pre = document.getElementById("jb-preview");
    const glyph = document.getElementById("jb-glyph");
    if (!phase || !wx || !pre || !glyph) return;
    glyph.innerHTML = glyphFor(s.sky, s.cyc > 1.02 && s.cyc < 1.98);
    phase.textContent = T.phase?.[s.phase] ?? "";
    phase.hidden = false;
    const wxT = document.getElementById("jb-wx-t");
    const wxW = document.getElementById("jb-wx-w");
    wx.hidden = s.temp === null;
    if (wxT) wxT.textContent = s.temp === null ? "" : `${Math.round(s.temp)}° ${s.label}`;
    if (wxW) wxW.textContent = s.temp !== null && s.compass ? `, ${T.wind} ${s.kmh} km/h ${s.compass}` : "";
    pre.hidden = !s.preview;
  }
  function tick() {
    const now = fakeClock !== null ? (params.get("t") || "").padStart(5, "0") : fmt.format(new Date());
    if (timeEl && timeEl.textContent !== now) {
      timeEl.textContent = now;
      timeEl.setAttribute("datetime", now);
    }
    update();
  }
  window.setInterval(tick, 15000);

  clock.add("clouds", (dt) => sky.tick(dt));

  /* ───────────── sky & shore life ───────────── */
  const lifeNow = () => (scene.state ? PHASES[scene.state.phase].life * env.birds : 0);
  const birds = createBirds(scene, { birds: qa<SVGSVGElement>(".jb-bird") }, { life: lifeNow });
  clock.add("birds", (dt) => birds.tick(dt));
  clock.sometimes(6, 13, () => birds.flock(), 2.6);

  // the sail boat crosses the horizon with the wind; a kitesurfer comes out when it blows
  const sail = createSail(scene, { sailGo: q(".jb-sail-go"), kiteGo: q(".jb-kite-go"), kiteArt: q<SVGSVGElement>(".jb-kite") });
  clock.add("sail", (dt) => sail.tick(dt));

  // lightning: far over the sea, rare and soft; a shooting star on a clear night
  clock.sometimes(12, 30, () => env.storm > 0.7 && sky.zap(), 5);
  clock.sometimes(14, 32, () => sky.shoot(), 7);

  // The director changes intentions, never positions or the animation clock.
  let tennisPolicy = LOCAL_TENNIS;
  const habitat = { action: "rally" as Action, remaining: 0, index: 0, context: "sunny" as Context,
    plan: fallback("sunny"), requests: 0, requested: new Set<Context>(), fatigue: 0, resting: false };
  root.dataset.habitatSource = "local";
  const habitatContext = (): Context => root.hasAttribute("data-night") ? "night"
    : env.rMid > 0.1 || env.storm > 0.1 || scene.court === "wet" ? "wet" : env.wind > 0.55 ? "windy" : "sunny";
  async function requestHabitat(context: Context) {
    if (NOT_FOUND || habitat.requests >= 2 || habitat.requested.has(context)) return;
    habitat.requested.add(context);
    habitat.requests++;
    try {
      const response = await fetch(`/api/habitat?context=${context}`, { cache: "no-cache", signal: AbortSignal.timeout(14_000) });
      if (!response.ok) return;
      const data = await response.json();
      if (habitat.context === context) {
        reportHabitat(data);
        tennisPolicy = parseTennis(data.tennis?.policy) ?? LOCAL_TENNIS;
        root.dataset.tennisSource = data.tennis?.source === "typesafe" ? "typesafe" : "local";
      }
      const plan = parsePlan(data.plan, context);
      if (plan && habitat.context === context) {
        habitat.plan = plan;
        habitat.index = 0;
        root.dataset.habitatSource = data.source === "openrouter" ? "openrouter" : "local";
      }
    } catch { /* The local plan is already playing. No retries or catch-up calls. */ }
  }
  clock.add("habitat", (dt) => {
    // The task loop pauses for intro, hidden tabs, mobile sheets and reduced motion.
    const context = habitatContext();
    if (context !== habitat.context) {
      habitat.context = context;
      tennisPolicy = LOCAL_TENNIS;
      reportHabitat({ source: "local", tennis: { source: "local" } });
      root.dataset.tennisSource = "local";
      habitat.plan = fallback(context);
      habitat.index = 0;
      habitat.remaining = 0;
      root.dataset.habitatSource = "local";
    }
    if (habitat.requests < 2 && !habitat.requested.has(context)) void requestHabitat(context);
    // A rest lasts its full duration after the players have retrieved the ball.
    if (habitat.action === "break" && scene.court === "play" && !habitat.resting && habitat.remaining > 0) return;
    habitat.remaining -= dt;
    if (habitat.remaining > 0) return;
    const next = habitat.plan.actions[habitat.index++ % habitat.plan.actions.length];
    habitat.action = allowed(next, context) ? next : "break";
    if (habitat.fatigue >= 6 && context !== "wet" && context !== "night") habitat.action = "break";
    habitat.resting = false;
    habitat.remaining = habitat.action === "break" ? 18 : 30;
    if (habitat.action === "break") habitat.fatigue = 0;
    if (habitat.action === "gull") gull?.invite();
    if (habitat.action === "crab") crab?.invite();
    root.dataset.habitat = habitat.action;
    if (scene.court === "play") recordHabitat(habitat.action);
  });

  // a gull lands on the sand, hops about, and leaves (dry daylight only)
  const gullEl = q(".jb-gull");
  const gull = gullEl ? createGull(scene, { gull: gullEl }, { life: lifeNow }) : null;
  if (gull) {
    clock.sometimes(24, 46, () => gull.invite(), 9);
    clock.add("gull", (dt) => gull.tick(dt));
  }

  // the crab: scuttles sideways along the damp sand, ducks into it when the pointer comes close. It loves rain and the dark.
  const crabEl = q(".jb-crab");
  const crab = crabEl ? createCrab(scene, { crab: crabEl }) : null;
  if (crab) clock.add("crab", (dt) => crab.tick(dt));

  // the beach ball: rolls when poked, drifts when it's windy, blows right off the beach in a storm and rolls home afterwards
  const beachBallEl = q<HTMLButtonElement>(".jb-ball");
  const beachBallArt = q(".jb-ball-art");
  const beachBall = beachBallEl && beachBallArt ? createBall(scene, { ball: beachBallEl, art: beachBallArt }) : null;
  if (beachBall && beachBallEl) {
    beachBallEl.addEventListener("click", (e) => {
      const r = beachBallEl.getBoundingClientRect();
      beachBall.poke(e.detail === 0 ? Math.random() < 0.5 : e.clientX < r.left + r.width / 2);
    });
    clock.add("ball", (dt) => beachBall.tick(dt));
  }

  /* ───────────── beach tennis: one-set Donald vs Wife exhibition, volleys only ───────────── */
  const court = q(".jb-court");
  let btSnap = () => {};
  // the 404 court has no players: it simply stays at rest, rackets by the net
  if (court && !NOT_FOUND) {
    const M = Number(court.dataset.m) || -0.085;
    const baseline = Number(court.dataset.baseline) || 140;
    const serveX = (face: number) => -face * (baseline + 24);
    const ballEl = q(".jb-bt-ball", court);
    const bshEl = q(".jb-bt-bsh", court);
    const pokEl = q(".jb-bt-pok", court);
    const puffEl = q(".jb-bt-puff", court);
    const netEl = q<SVGSVGElement>(".jb-bt-net", court);
    type Kind = "hi" | "lo";
    // racket arm, degrees about the shoulder: ready, backswing, contact, follow-through; dx/h = where the racket meets the ball
    const SW: Record<Kind, { dx: number; h: number; a: number[] }> = { hi: { dx: 15, h: 50, a: [-35, -140, -55, 25] }, lo: { dx: 22, h: 24, a: [-35, 125, 25, -60] } };
    type Pl = { el: HTMLElement; arm: SVGGElement | null; body: SVGGElement | null; la: SVGPathElement | null; lb: SVGPathElement | null; face: number; x: number; tx: number; home: number; step: number; hitAt: number; kind: Kind };
    const mk = (k: string, face: number): Pl => {
      const el = q(`.jb-bt-pl-${k}`, court) as HTMLElement;
      return { el, arm: q<SVGGElement>(".bt-arm", el), body: q<SVGGElement>(".bt-body", el), la: q<SVGPathElement>(".bt-leg-a", el), lb: q<SVGPathElement>(".bt-leg-b", el), face, x: -face * 36, tx: -face * 36, home: -face * 86, step: 0, hitAt: -9, kind: "hi" };
    };
    const P = [mk("a", 1), mk("b", -1)];
    let match = createMatch();
    const publishMatch = (announce = false) => {
      reportMatch(match, announce);
      court.dataset.server = String(match.server);
      court.dataset.games = match.games.join("-");
      court.dataset.points = match.points.join("-");
      court.dataset.tiebreak = String(match.tieBreak);
    };
    publishMatch();
    let changingEnds = false;
    let changeStart = P.map(p => p.x);
    const placeEnds = () => {
      changingEnds = P[0].face !== (match.ends ? -1 : 1);
      if (changingEnds) changeStart = P.map(p => p.x);
      P.forEach((p, i) => {
        p.face = (i === 0 ? 1 : -1) * (match.ends ? -1 : 1);
        p.home = -p.face * 86;
        p.tx = p.home;
      });
    };
    type Seg = { x1: number; h1: number; H: number; T: number; bend?: number; then: "return" | "serve" | "whiff" | "net" | "net-over" | "ground" | "rest" };
    const ball = { x: 0, h: 0, x0: 0, h0: 0, t: 0, on: false, segs: [] as Seg[] };
    let courtTime = 0;
    let mode: "off" | "toServe" | "fly" | "dead" | "fetch" | "leave" | "matchOver" = "off";
    let rally = 0, server: Player = 0, rcv: Player = 1, collector: Player = 0, wait = 0, leaveT = 0;
    let lastHitter: Player = 0;
    let hitterEnd: -1 | 1 = -1;
    let pointLive = false;
    let serveFlight = false;
    const finishPoint = (result: { winner: Player; reason: PointReason }) => {
      if (!pointLive) return;
      pointLive = false;
      match = awardPoint(match, result.winner, result.reason);
      publishMatch(true);
      court.dataset.pointReason = result.reason;
    };
    const burst = (el: HTMLElement | null, x: number, h: number) => {
      if (!el) return;
      el.style.transform = `translate3d(${x.toFixed(1)}px,${(M * x - h).toFixed(1)}px,0)`;
      el.classList.remove("is-go");
      void el.getBoundingClientRect();
      el.classList.add("is-go");
    };
    const showBall = (on: boolean) => {
      ball.on = on;
      ballEl?.classList.toggle("is-on", on);
      bshEl?.classList.toggle("is-on", on);
    };
    const fly = (segs: Seg[]) => {
      ball.segs = segs;
      ball.x0 = ball.x;
      ball.h0 = ball.h;
      ball.t = 0;
      mode = "fly";
    };
    const bounces = (x: number, dir: number): Seg[] => [{ x1: x + dir * 17, h1: 0, H: 11, T: 0.36, then: "ground" }, { x1: x + dir * 26, h1: 0, H: 4.5, T: 0.22, then: "rest" }];
    function hit(by: Player, serve = false) {
      const me = P[by], ot = P[other(by)], dir = me.face, wind = env.wind || 0;
      // A return must come from the opposing side; no passes or second contacts.
      if (!serve && by === lastHitter) {
        finishPoint(faultWinner(by, "double-hit"));
        fly([{ x1: ball.x, h1: 0, H: 0, T: 0.3, then: "rest" }]);
        return;
      }
      lastHitter = by;
      hitterEnd = -me.face as -1 | 1;
      serveFlight = serve;
      ball.x = me.x + dir * SW[me.kind].dx;
      ball.h = SW[me.kind].h;
      rcv = other(by);
      const r = Math.random();
      const situation = Math.abs(me.x - me.home) > 26 ? "stretched" : habitat.fatigue >= 4 || rally >= 6 ? "tired" : "balanced";
      const shot = serve ? "lob" : chooseShot(tennisPolicy, situation, habitat.action, r);
      if (court) {
        court.dataset.shot = shot;
        court.dataset.situation = situation;
      }
      recordHabitat(shot, situation, by, serve);
      const T = shot === "drive" ? rand(0.82, 1) : shot === "lob" ? rand(1.3, 1.6) : rand(0.95, 1.1);
      const H = shot === "drive" ? rand(12, 20) : shot === "lob" ? rand(34, 50) : rand(24, 30);
      const dist = shot === "drive" ? rand(60, 110) : shot === "lob" ? rand(88, 118) : rand(44, 58);
      const kind: Kind = shot === "drop" ? "lo" : "hi";
      const bend = env.windX * wind * 36; // a strong wind bows the flight; the receiver still reads it
      const pf = serve ? 0.04 : clamp(0.07 + rally * 0.03 + wind * 0.2, 0, 0.5);
      const fault = Math.random() < pf ? ["net", "long", "miss"][Math.floor(rand(0, 3))] : "";

      const X = dir * dist;
      me.tx = me.home;
      if (fault === "net") {
        ot.tx = ot.home;
        fly([{ x1: -dir * 4, h1: rand(24, 36), H: 7, T: T * 0.5, then: "net" }, { x1: -dir * 10, h1: 0, H: 0, T: 0.42, then: "ground" }, { x1: -dir * 15, h1: 0, H: 3, T: 0.2, then: "rest" }]);
      } else if (fault === "long") {
        const out = dir * rand(152, 172);
        ot.tx = dir * rand(92, 108);
        fly([{ x1: out, h1: 0, H: H + 14, T: T * 1.12, bend, then: "ground" }, ...bounces(out, dir)]);
      } else {
        ot.kind = kind;
        ot.tx = X + dir * SW[kind].dx + (fault ? dir * 15 : 0); // a miss: read it a step too deep
        ot.hitAt = courtTime + T;
        if (serve && !fault && Math.random() < 0.08) {
          // A serve brushing the tape stays live. It is never replayed as a let.
          ot.hitAt = courtTime + T + 0.15;
          fly([{ x1: 0, h1: 43.5, H: 14, T: T * 0.5, then: "net-over" }, { x1: X, h1: SW[kind].h, H: 12, T: T * 0.5 + 0.15, then: "return" }]);
        } else fly(fault ? [{ x1: X, h1: SW[kind].h, H, T, bend, then: "whiff" }, { x1: X + dir * 30, h1: 0, H: 0, T: 0.34, then: "ground" }, ...bounces(X + dir * 30, dir)] : [{ x1: X, h1: SW[kind].h, H, T, bend, then: "return" }]);
      }
    }
    function toss(by: Player) {
      const me = P[by];
      // Both feet stay behind the painted baseline until racket contact.
      me.x = me.tx = serveX(me.face);
      me.step = 0;
      pointLive = true;
      me.kind = "hi";
      me.hitAt = courtTime + 0.62;
      ball.x = me.x + me.face * 9;
      ball.h = 28;
      showBall(true);
      fly([{ x1: me.x + me.face * SW.hi.dx, h1: SW.hi.h, H: 20, T: 0.62, then: "serve" }]);
    }
    const armAt = (p: Pl): number => {
      const tau = courtTime - p.hitAt, a = SW[p.kind].a;
      if (tau < -0.5 || tau > 0.55) return a[0];
      if (tau < -0.13) return a[0] + (a[1] - a[0]) * ease((tau + 0.5) / 0.37);
      if (tau < 0) return a[1] + (a[2] - a[1]) * ((tau + 0.13) / 0.13) ** 2;
      if (tau < 0.14) return a[2] + (a[3] - a[2]) * (1 - (1 - tau / 0.14) ** 2);
      return a[3] + (a[0] - a[3]) * ease((tau - 0.14) / 0.41);
    };
    function pose(p: Pl, v: number) {
      const walk = clamp(Math.abs(v) / 30, 0, 1), sw = Math.sin(p.step) * walk * 24;
      const tau = courtTime - p.hitAt;
      const hop = tau > -0.12 && tau < 0.2 ? Math.sin((Math.PI * (tau + 0.12)) / 0.32) * (p.kind === "hi" ? 4 : 1.5) : 0;
      const index = P.indexOf(p);
      const travel = clamp((p.x - changeStart[index]) / (p.tx - changeStart[index] || 1), 0, 1);
      const aroundPost = changingEnds ? Math.sin(Math.PI * travel) * (index ? -48 : 48) : 0;
      p.el.style.transform = `translate3d(${(p.x - 30).toFixed(1)}px,${(M * p.x - 64 + aroundPost).toFixed(1)}px,0) scaleX(${p.face})`;
      if (p.body) p.body.style.transform = `translate(0px,${(-hop - Math.abs(Math.sin(p.step)) * walk * 1.3).toFixed(1)}px) translate(0px,-20px) rotate(${(clamp(v / 95, -1, 1) * p.face * 6).toFixed(1)}deg) translate(0px,20px)`;
      if (p.arm) p.arm.style.transform = `translate(3px,-33px) rotate(${armAt(p).toFixed(1)}deg) translate(-3px,33px)`;
      if (p.la) p.la.style.transform = `translate(-1px,-19px) rotate(${sw.toFixed(1)}deg) translate(1px,19px)`;
      if (p.lb) p.lb.style.transform = `translate(1.5px,-19px) rotate(${(-sw).toFixed(1)}deg) translate(-1.5px,19px)`;
    }
    function putBall() {
      if (ballEl) ballEl.style.transform = `translate3d(${ball.x.toFixed(1)}px,${(M * ball.x - ball.h).toFixed(1)}px,0)`;
      if (bshEl) bshEl.style.transform = `translate3d(${(ball.x + ball.h * 0.12).toFixed(1)}px,${(M * ball.x + 1).toFixed(1)}px,0) scale(${clamp(1 - ball.h / 150, 0.45, 1).toFixed(2)})`;
    }
    // without the courtTime (reduced motion) the court still tells the truth: a held pose, or the rackets by the net
    const hold = () => {
      court.dataset.bt = scene.court;
      mode = "off";
      if (scene.court !== "play") return;
      P.forEach((p) => {
        p.x = p.home;
        p.hitAt = -9;
        pose(p, 0);
      });
      ball.x = -34;
      ball.h = 74;
      showBall(true);
      putBall();
    };
    btSnap = () => {
      if (!clock.running) hold();
    };
    clock.add("rally", (dt) => {
      if (mode === "off") {
        if (scene.court === "play") {
          if (match.winner !== null) { mode = "matchOver"; wait = 9; return; }
          const alreadyOnCourt = court.dataset.bt === "play";
          court.dataset.bt = "play";
          P.forEach((p) => {
            // Continue from the sketched pose when loading hands over to the rally.
            if (!alreadyOnCourt) p.x = -p.face * 36;
            p.tx = p.home;
            p.hitAt = -9;
          });
          placeEnds();
          server = match.server;
          P[server].tx = serveX(P[server].face);
          showBall(false);
          mode = "toServe";
          wait = 0.7;
        } else if (court.dataset.bt !== scene.court) court.dataset.bt = scene.court;
        if (mode === "off") return;
      } else if (scene.court !== "play" && mode !== "leave") {
        mode = "leave";
        pointLive = false; // Weather suspends the unfinished point, preserving the score and server.
        ball.segs = [];
        leaveT = 2.4;
        showBall(false);
        P.forEach((p) => (p.tx = -p.face * 36));
      }
      courtTime += dt;
      if (mode === "matchOver") {
        wait -= dt;
        if (wait <= 0) {
          match = createMatch(other(match.firstServer));
          habitat.fatigue = 0;
          publishMatch();
          mode = "off";
        }
        return;
      }
      for (const p of P) {
        const v = clamp((p.tx - p.x) * 5.5, -96, 96);
        p.x += v * dt;
        p.step += Math.abs(v) * dt * 0.21;
        pose(p, v);
      }
      if (mode === "leave") {
