  });
  const btnFor = (id: string | null) => openers.find((b) => b.dataset.open === id) ?? null;
  const hostOf = (id: string | null) => (id === "work" ? book : id ? panel : null);

  /* the notebook's pages */
  const spreads = qa(".jb-spread");
