  .jb-rain-mid { opacity: var(--r-mid, 0); background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='280'><g stroke='%23f1f8fd' stroke-width='1.5' stroke-linecap='round' opacity='.75'><path d='M16 8v22M60 50v24M112 20v22M38 130v24M92 110v22M128 190v24M70 210v22M8 236v22M104 250v20'/></g></svg>"); }
  .jb-rain-near { opacity: var(--r-near, 0); background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='360'><g stroke='%23f6fbff' stroke-width='2.1' stroke-linecap='round' opacity='.8'><path d='M24 10v36M96 70v40M170 30v36M58 190v40M140 170v38M188 270v38M10 290v36M112 300v36'/></g></svg>"); }
  .jb-rain-first { opacity: var(--r-first, 0); background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='330' height='360'><g stroke='%23f6fbff' stroke-width='2.2' stroke-linecap='round' opacity='.8'><path d='M40 20v30M210 150v32M300 60v28M120 280v30'/></g></svg>"); }
  .jb-tint { position: absolute; inset: 0; background: var(--tint-c, #7f8c99); opacity: var(--tint, 0); transition: opacity 0.4s linear; pointer-events: none; }
  .jb-dimmer { position: absolute; inset: 0; background: #1c2f4a; opacity: 0; pointer-events: none; }
  .jb-veiled { filter: url(#veil); }
  .jb-grain { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: multiply; opacity: 0.4;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.35  0 0 0 0 0.28  0 0 0 0 0.16  0 0 0 0.9 -0.25'/></filter><rect width='240' height='240' filter='url(%23n)'/></svg>"); }
  .jb-fg { display: none; }
