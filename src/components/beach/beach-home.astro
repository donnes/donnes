    });
  }

  // the crab: scuttles sideways along the damp sand, ducks into it when the pointer comes close. It loves rain and the dark.
  const crab = q(".jb-crab");
  const pointer = { x: -999, y: -999 };
  if (crab) {
    const c = { x: 0, y: 0, dir: 1, lo: 0, hi: 0, mode: "gone" as "gone" | "walk" | "pause" | "hide", wait: 0, shy: 0, phase: 0, idle: 5 };
    const place = () => (crab.style.transform = `translate3d(${c.x.toFixed(1)}px,${c.y.toFixed(1)}px,0)`);
    inviteCrab = () => { if (c.mode === "gone") c.idle = 0; };
    const bold = () => env.rMid > 0.2 || root.hasAttribute("data-night");
    tasks.push((dt) => {
      if (c.mode === "gone") {
        c.idle -= dt * (bold() ? 4 : 1); // comes out about four times as often in the rain or at night
        if (c.idle > 0 || LITE || env.storm > 0.5) return;
        c.idle = rand(20, 42);
        c.dir = Math.random() < 0.5 ? 1 : -1;
        c.lo = fit.left - 40;
        c.hi = fit.left + fit.width * (bold() ? 0.95 : 0.5);
        c.x = c.dir > 0 ? c.lo : c.hi;
        c.mode = "walk";
        c.wait = rand(1.2, 2.6);
        crab.classList.add("is-out", "is-walking");
        crab.classList.remove("is-hid");
        return;
      }
      const close = Math.hypot(pointer.x - (fit.ox + c.x * fit.s), pointer.y - (fit.oy + c.y * fit.s)) < 120;
      if (close && c.mode !== "hide") {
