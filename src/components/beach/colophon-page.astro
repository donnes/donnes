---
import type { BeachLang } from "./strings";

interface Props {
  lang: BeachLang;
}

const { lang } = Astro.props;
const isPt = lang === "pt-br";
const homeHref = isPt ? "/pt-br/" : "/";
const languageHref = isPt ? "/colophon/" : "/pt-br/colophon/";

const copy = isPt
  ? {
      back: "Voltar para a praia",
      language: "Read in English",
      eyebrow: "Notas da praia · Florianópolis",
      title: "Colophon",
      intro:
        "Este site é uma pequena praia digital, desenhada e construída por Donald Silveira.",
      buildTitle: "Construção",
      build:
        "Feito com Astro e TypeScript. A cena, os objetos e os personagens são desenhados com HTML, CSS e SVG, sem canvas ou biblioteca de animação.",
      typeTitle: "Tipografia",
      type: "Geist cuida da interface, Geist Mono dos pequenos rótulos e Fraunces dá voz aos títulos. Caveat aparece nas anotações à mão.",
      weatherTitle: "Tempo e lugar",
      weather:
        "O céu acompanha o horário de Florianópolis. Quando disponível, dados da Open-Meteo ajustam nuvens, chuva, vento e temperatura.",
      inspirationTitle: "Inspiração",
      inspiration:
        "Inspirado pela Ilha de Santa Catarina, por tardes em Jurerê e por sites pessoais que parecem lugares, não templates.",
      note: "Desenhado no Brasil · construído para a web aberta",
    }
  : {
      back: "Back to the beach",
      language: "Ler em português",
      eyebrow: "Beach notes · Florianópolis",
      title: "Colophon",
      intro:
        "This site is a small digital beach, designed and built by Donald Silveira.",
      buildTitle: "Built with",
      build:
        "Astro and TypeScript. The scene, objects, and characters are drawn with HTML, CSS, and SVG, without canvas or an animation library.",
      typeTitle: "Typography",
      type: "Geist handles the interface, Geist Mono the small labels, and Fraunces gives the headings their voice. Caveat appears in handwritten notes.",
      weatherTitle: "Weather and place",
      weather:
        "The sky follows the local time in Florianópolis. When available, Open-Meteo data adjusts the clouds, rain, wind, and temperature.",
      inspirationTitle: "Inspiration",
      inspiration:
        "Inspired by Santa Catarina Island, afternoons in Jurerê, and personal websites that feel like places instead of templates.",
      note: "Drawn in Brazil · built for the open web",
    };
---

<main class="colophon-shell">
  <div class="sky" aria-hidden="true">
    <span class="sun"></span>
    <span class="cloud cloud-one"></span>
    <span class="cloud cloud-two"></span>
  </div>
  <div class="sea" aria-hidden="true"><span></span><span></span></div>
  <div class="sand" aria-hidden="true"></div>

  <nav class="topbar" aria-label={isPt ? "Navegação" : "Navigation"}>
    <a class="nav-link" href={homeHref}>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12.5 4.5-5 5 5 5M8 9.5h8" /></svg>
      {copy.back}
    </a>
    <a class="nav-link language" href={languageHref}>{copy.language}</a>
  </nav>

  <article class="paper">
    <div class="tape tape-left" aria-hidden="true"></div>
    <div class="tape tape-right" aria-hidden="true"></div>
    <header>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="intro">{copy.intro}</p>
    </header>

    <div class="details">
      <section>
        <p class="number">01</p>
        <div><h2>{copy.buildTitle}</h2><p>{copy.build}</p></div>
      </section>
      <section>
        <p class="number">02</p>
        <div><h2>{copy.typeTitle}</h2><p>{copy.type}</p></div>
      </section>
      <section>
        <p class="number">03</p>
        <div><h2>{copy.weatherTitle}</h2><p>{copy.weather}</p></div>
      </section>
      <section>
        <p class="number">04</p>
        <div><h2>{copy.inspirationTitle}</h2><p>{copy.inspiration}</p></div>
      </section>
    </div>

    <footer>
      <span>{copy.note}</span>
      <span class="shell-mark" aria-hidden="true">◒</span>
    </footer>
  </article>
</main>

<style>
  :global(html) { background: #e8d19b; }
  :global(body) { color: #29271f; overflow-x: hidden; }
  .colophon-shell { position: relative; min-height: 100svh; padding: 88px 20px 72px; isolation: isolate; overflow: hidden; }
  .sky, .sea, .sand { position: fixed; inset-inline: 0; z-index: -3; }
  .sky { top: 0; height: 42vh; background: linear-gradient(#69b8e5, #b9def0); }
  :global(html[data-tod="night"]) .sky { background: linear-gradient(#111a3b, #34456a); }
  :global(html[data-tod="dawn"]) .sky { background: linear-gradient(#5b6595, #e6b49d); }
  :global(html[data-tod="golden"]) .sky { background: linear-gradient(#559fc9, #f3c588); }
  :global(html[data-tod="dusk"]) .sky { background: linear-gradient(#354373, #d48f88); }
  .sea { top: 39vh; height: 19vh; background: linear-gradient(#3f9cb8, #2f829b); border-top: 2px solid rgba(255,255,255,.65); }
  .sea span { position: absolute; left: -5%; width: 110%; height: 2px; background: rgba(255,255,255,.42); transform: rotate(-.7deg); }
  .sea span:first-child { top: 31%; } .sea span:last-child { top: 69%; transform: rotate(.5deg); }
  .sand { top: 55vh; bottom: 0; background: #e8d19b; }
  .sand::after { content: ""; position: absolute; inset: 0; opacity: .24; background-image: radial-gradient(#8c744b 0.65px, transparent .75px); background-size: 9px 9px; }
  .sun { position: absolute; width: 74px; height: 74px; border-radius: 50%; top: 64px; right: 11vw; background: #ffe49a; box-shadow: 0 0 50px rgba(255,226,142,.72); }
  :global(html[data-tod="night"]) .sun { background: #e8edf1; box-shadow: 0 0 35px rgba(222,231,239,.32); }
  .cloud { position: absolute; width: 108px; height: 20px; border-radius: 50%; background: rgba(255,255,255,.64); box-shadow: 30px -9px 0 2px rgba(255,255,255,.64), 63px 0 0 rgba(255,255,255,.64); }
  .cloud-one { top: 120px; left: 9vw; } .cloud-two { top: 210px; right: 24vw; transform: scale(.7); opacity: .65; }
  .topbar { position: absolute; z-index: 2; top: 22px; left: 50%; width: min(920px, calc(100% - 40px)); transform: translateX(-50%); display: flex; justify-content: space-between; align-items: center; }
  .nav-link { display: inline-flex; align-items: center; gap: 7px; min-height: 38px; padding: 0 13px; border: 1px solid rgba(49,54,45,.24); border-radius: 999px; background: rgba(255,250,231,.82); color: #29271f; font: 600 11px/1 "Geist Mono", monospace; letter-spacing: .03em; text-decoration: none; box-shadow: 0 2px 8px rgba(62,54,37,.1); backdrop-filter: blur(8px); transition: transform 160ms cubic-bezier(.23,1,.32,1), background-color 160ms ease; }
  .nav-link svg { width: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .nav-link:active { transform: scale(.97); }
  .paper { position: relative; width: min(760px, 100%); margin: 0 auto; padding: clamp(34px, 6vw, 66px); background: #f7f0dc; box-shadow: 0 3px 0 rgba(93,69,32,.12), 0 24px 65px rgba(62,48,23,.24); transform: rotate(-.35deg); }
  .paper::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .28; background-image: radial-gradient(#877d65 .45px, transparent .55px); background-size: 6px 6px; mix-blend-mode: multiply; }
  .tape { position: absolute; top: -15px; width: 92px; height: 31px; background: rgba(231,214,166,.78); box-shadow: 0 1px 3px rgba(61,50,27,.1); }
  .tape-left { left: 11%; transform: rotate(-4deg); } .tape-right { right: 10%; transform: rotate(5deg); }
  header { position: relative; padding-bottom: 35px; border-bottom: 1px solid #c9bea4; }
  .eyebrow, .number, footer { font-family: "Geist Mono", monospace; text-transform: uppercase; letter-spacing: .11em; }
  .eyebrow { margin: 0 0 14px; color: #6b6555; font-size: 10px; }
  h1 { margin: 0; font: 500 clamp(48px, 8vw, 76px)/.94 "Fraunces", Georgia, serif; letter-spacing: -.045em; color: #203d34; }
  .intro { max-width: 550px; margin: 22px 0 0; font: 400 clamp(17px, 2.3vw, 21px)/1.5 "Fraunces", Georgia, serif; color: #4a473d; }
  .details section { position: relative; display: grid; grid-template-columns: 52px 1fr; gap: 15px; padding: 27px 0; border-bottom: 1px solid #d7cdb6; }
  .number { margin: 4px 0 0; color: #a0523f; font-size: 10px; }
  h2 { margin: 0 0 8px; color: #203d34; font: 650 17px/1.2 "Geist", sans-serif; }
  section p:last-child { margin: 0; color: #575247; font: 400 14px/1.65 "Geist", sans-serif; }
  footer { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 27px; color: #77705f; font-size: 9px; line-height: 1.5; }
  .shell-mark { color: #a0523f; font-size: 27px; line-height: 1; transform: rotate(-18deg); }
  @media (hover: hover) and (pointer: fine) { .nav-link:hover { background: #fff9e8; transform: translateY(-1px); } }
  @media (max-width: 560px) {
    .colophon-shell { padding: 78px 12px 42px; }
    .topbar { top: 16px; width: calc(100% - 24px); }
    .nav-link { padding: 0 11px; font-size: 10px; }
    .language { max-width: 48%; text-align: center; }
    .paper { padding: 38px 26px 30px; transform: none; }
    .details section { grid-template-columns: 36px 1fr; gap: 9px; }
    .sun { width: 56px; height: 56px; top: 76px; }
  }
  @media (prefers-reduced-motion: reduce) { .nav-link { transition: background-color 160ms ease; } }
</style>
