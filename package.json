{
  "name": "donnes.dev",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --apply ./src",
    "format": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --apply ./src",
    "test": "node --test --experimental-strip-types --import ./tests/resolve-ts.mjs tests/*.test.ts",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.7.0",
    "@astrojs/mdx": "^3.1.0",
    "@astrojs/react": "^3.5.0",
    "@astrojs/rss": "^4.0.6",
    "@astrojs/sitemap": "^3.1.5",
    "@astrojs/tailwind": "^5.1.0",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "astro": "^4.10.2",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "vite": "^5.4.21",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": "22.x"
  }
}
